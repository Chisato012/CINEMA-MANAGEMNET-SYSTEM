@model Booking
@using System.Globalization
@* Quang An *@
@{
    Layout = null;
    ViewData["Title"] = "Thanh toán thành công | Cosmos Cinema";

    //Lấy ra các biến 

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var tickets = Model.Tickets
        .OrderBy(ticket => ticket.Seat?.SeatCode)
        .ToList();
    var combos = Model.BookingCombos
        .Where(item => item.Quantity > 0)
        .OrderBy(item => item.Combo?.ComboName)
        .ToList();
    var payment = Model.Payments
        .OrderByDescending(item => item.PaymentDate)
        .FirstOrDefault();
    var showtime = tickets.FirstOrDefault()?.Showtime;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
</head>

<body class="min-h-[100dvh] bg-[#121212] font-[Manrope] text-[#FFEDE3]">
    <main class="mx-auto w-full max-w-6xl px-4 py-8 md:px-6 lg:py-14">
        <header class="mb-8 max-w-3xl">
            <p class="font-['JetBrains_Mono'] text-xs uppercase text-[#D6A079]">
                Giao dịch đã hoàn tất
            </p>
            <h1 class="mt-3 font-['Archivo_Narrow'] text-4xl font-bold leading-none md:text-5xl">
                Thanh toán thành công
            </h1>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-[#BCAEA5]">
                Vé đã được xác nhận. Bạn có thể dùng mã vé bên dưới khi đến rạp.
            </p>
        </header>

        @if (TempData["PaymentSuccess"] is string successMessage)
        {
            <div class="mb-6 rounded-md border border-[#456B58] bg-[#1B2A22] px-4 py-3 text-sm text-[#BFE2CC]"
                 role="status"
                 aria-live="polite">
                @successMessage
            </div>
        }

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.2fr_.8fr]">
            <section class="rounded-md border border-[#f3bb92] bg-[#211F1E] p-5 shadow-[0_18px_45px_-30px_rgba(48,20,0,.8)] md:p-7">
                <div class="flex flex-col gap-4 border-b border-[#f3bb92] pb-6 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <p class="font-['JetBrains_Mono'] text-xs uppercase text-[#B98661]">Mã đặt vé</p>
                        <p class="mt-2 font-['JetBrains_Mono'] text-xl font-semibold text-[#F4BB92]">
                            #@Model.BookingID.ToString("D6")
                        </p>
                    </div>
                    <span class="w-fit rounded border border-[#5E765F] bg-[#263329] px-3 py-2 font-['JetBrains_Mono'] text-xs text-[#BFE2CC]">
                        @Model.Status
                    </span>
                </div>

                <dl class="divide-y divide-[#f3bb92] text-sm">
                    <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-5">
                        <dt class="text-[#BCAEA5]">Ngày đặt</dt>
                        <dd class="text-right font-['JetBrains_Mono'] text-[#FFEDE3]">
                            @Model.BookingDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </dd>
                    </div>

                    @if (showtime != null)
                    {
                        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-5">
                            <dt class="text-[#BCAEA5]">Suất chiếu</dt>
                            <dd class="text-right font-['JetBrains_Mono'] text-[#FFEDE3]">
                                @showtime.Date.ToString("dd/MM/yyyy") · @showtime.StartTime.ToString("HH:mm")
                            </dd>
                        </div>
                    }

                    <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-5">
                        <dt class="text-[#BCAEA5]">Ghế</dt>
                        <dd class="text-right font-['JetBrains_Mono'] text-[#FFEDE3]">
                            @(tickets.Count > 0
                                ? string.Join(", ", tickets.Select(ticket => ticket.Seat?.SeatCode ?? "--"))
                                : "Không có dữ liệu")
                        </dd>
                    </div>

                    <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-5">
                        <dt class="text-[#BCAEA5]">Phương thức</dt>
                        <dd class="text-right font-['JetBrains_Mono'] text-[#FFEDE3]">
                            @(payment?.PaymentMethod?.MethodName ?? "Không xác định")
                        </dd>
                    </div>
                </dl>

                <div class="border-t border-[#f3bb92] pt-6">
                    <div class="flex items-end justify-between gap-5">
                        <span class="text-sm text-[#BCAEA5]">Tổng đã thanh toán</span>
                        <strong class="text-right font-['JetBrains_Mono'] text-2xl text-[#F4BB92] md:text-3xl">
                            @Model.TotalAmount.ToString("C", vi)
                        </strong>
                    </div>
                </div>
            </section>

            <aside class="rounded-md border border-[#f3bb92] bg-[#211F1E] p-5 md:p-7 lg:sticky lg:top-6">
                <div class="border-b border-[#f3bb92] pb-5">
                    <p class="font-['JetBrains_Mono'] text-xs uppercase text-[#B98661]">Vé điện tử</p>
                    <h2 class="mt-2 font-['Archivo_Narrow'] text-2xl font-bold">Mã vé của bạn</h2>
                </div>

                @if (tickets.Count > 0)
                {
                    <div class="divide-y divide-[#f3bb92]">
                        @foreach (var ticket in tickets)
                        {
                            <div class="py-5">
                                <div class="flex items-center justify-between gap-4">
                                    <span class="font-semibold text-[#FFEDE3]">
                                        Ghế @(ticket.Seat?.SeatCode ?? "--")
                                    </span>
                                    <span class="font-['JetBrains_Mono'] text-xs text-[#D6A079]">
                                        @(ticket.Seat?.SeatType ?? "--")
                                    </span>
                                </div>
                                <p class="mt-3 break-all rounded bg-[#171514] px-3 py-3 font-['JetBrains_Mono'] text-xs text-[#F4BB92]">
                                    @ticket.TicketCode
                                </p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="my-6 rounded-md border border-dashed border-[#f3bb92] px-4 py-8 text-center text-sm text-[#8F847D]">
                        Chưa có dữ liệu vé.
                    </div>
                }

                @if (combos.Count > 0)
                {
                    <div class="border-t border-[#f3bb92] pt-5">
                        <p class="font-['JetBrains_Mono'] text-xs uppercase text-[#B98661]">Combo đã mua</p>
                        <div class="mt-4 space-y-3 text-sm">
                            @foreach (var item in combos)
                            {
                                <div class="flex justify-between gap-4">
                                    <span class="text-[#BCAEA5]">
                                        @item.Combo?.ComboName × @item.Quantity
                                    </span>
                                    <span class="font-['JetBrains_Mono'] text-[#FFEDE3]">
                                        @((item.UnitPrice * item.Quantity).ToString("C", vi))
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <a asp-controller="Home" asp-action="Index" class="mt-7 block w-full rounded-md bg-[#B98661] px-5 py-4 text-center font-semibold text-[#301400] transition duration-200 hover:bg-[#D6A079] active:scale-[.98]">
                    Trở về trang chủ
                </a>
            </aside>
        </div>
    </main>
</body>
</html>
