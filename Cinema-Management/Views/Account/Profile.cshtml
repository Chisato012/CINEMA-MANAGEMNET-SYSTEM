@model User
@using System.Globalization
@{
    ViewData["Title"] = "Trang cá nhân";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var fullName = Model?.FullName ?? Context.Session.GetString("UserFullName") ?? "Khach hang COSMOS";
    var email = Model?.Email ?? Context.Session.GetString("UserEmail") ?? "";
    var phone = Model?.PhoneNumber ?? "Chua cap nhat";
    var dob = Model?.DOB;
    var avatarInitial = !string.IsNullOrWhiteSpace(fullName)
        ? fullName.Trim()[0].ToString().ToUpperInvariant()
        : "C";

    var completedBookings = (Model?.Bookings ?? new List<Booking>())
        .OrderByDescending(booking => booking.BookingDate)
        .ToList();
    var latestBooking = completedBookings.FirstOrDefault();
    var latestTickets = latestBooking?.Tickets
        .OrderBy(ticket => ticket.Seat?.SeatCode)
        .ToList() ?? new List<Ticket>();
    var latestShowtime = latestTickets.FirstOrDefault()?.Showtime;
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
}

<main class="cosmos-profile">
    <section class="cosmos-profile__shell" aria-labelledby="profile-title">
        <aside class="profile-card">
            <button type="button"
                    class="profile-avatar-button"
                    id="profileAvatarButton"
                    data-open-modal="avatarMenuModal"
                    aria-label="Doi anh dai dien">
                <img id="profileAvatarImage" src="" alt="Anh dai dien cua @fullName" />
                <span class="profile-avatar-initial" id="profileAvatarInitial">@avatarInitial</span>
                <span class="profile-avatar-edit" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M4.75 16.2 15.9 5.05a2.12 2.12 0 0 1 3 0l.05.05a2.12 2.12 0 0 1 0 3L7.8 19.25H4.75V16.2Z" />
                        <path d="m14.25 6.7 3.05 3.05" />
                    </svg>
                </span>
            </button>

            <h1 id="profile-title">@fullName</h1>
            <div class="profile-card__meta">
                <span>@email</span>
                <span>@phone</span>
            </div>

            <dl class="profile-card__facts">
                <div>
                    <dt>Vai trò</dt>
                    <dd>@(Model?.Role ?? "Customer")</dd>
                </div>
                <div>
                    <dt>Ngày sinh</dt>
                    <dd>@(dob.HasValue ? dob.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</dd>
                </div>
                <div>
                    <dt>Vé đã đặt</dt>
                    <dd>@completedBookings.Sum(booking => booking.Tickets.Count)</dd>
                </div>
            </dl>

            <button type="button" class="profile-primary-button" data-open-modal="editProfileModal">
                Chỉnh sửa thông tin
            </button>
        </aside>

        <div class="profile-board">
            <section class="recent-ticket" aria-labelledby="recent-ticket-title">
                <div class="recent-ticket__copy">
                    <div>
                        <span class="profile-kicker">
                            <i class="fa-solid fa-ticket"></i>
                                Vé đặt gần đây
                        </span>
                        <h2 id="recent-ticket-title">
                            @(latestShowtime?.Movie?.Title ?? "CHƯA CÓ VÉ MỚI")
                        </h2>
                    </div>

                    @if (latestBooking != null && latestShowtime != null)
                    {
                        <div class="recent-ticket__facts">
                            <div>
                                <span>Ngày và giờ</span>
                                <strong>@latestShowtime.Date.ToString("dd/MM/yyyy") - @latestShowtime.StartTime.ToString("HH:mm")</strong>
                            </div>
                            <div>
                                <span>Phòng / Ghế</span>
                                <strong>@(latestShowtime.Room?.RoomName ?? $"Phong {latestShowtime.RoomID}") / @string.Join(", ", latestTickets.Select(ticket => ticket.Seat?.SeatCode ?? "--"))</strong>
                            </div>
                            <div>
                                <span>Thanh toán</span>
                                <strong>@latestBooking.TotalAmount.ToString("C0", vi)</strong>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="profile-empty">Vé sẽ tự động xuất hiện tại đây sau khi bạn hoàn tất đặt vé.</p>
                    }
                </div>
            </section>

            <section class="booking-ledger" aria-labelledby="booking-history-title">
                <div class="booking-ledger__header">
                    <div>
                        <span class="profile-kicker">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            Lịch sử đặt vé
                        </span>
                        <h2 id="booking-history-title">HÀNH TRÌNH ĐIỆN ẢNH</h2>
                    </div>
                    <span class="profile-status">@completedBookings.Count booking</span>
                </div>

                @if (completedBookings.Any())
                {
                    <div class="booking-table-wrap">
                        <table class="booking-table">
                            <thead>
                                <tr>
                                    <th>Phim</th>
                                    <th>Phòng</th>
                                    <th>Ngày / giờ</th>
                                    <th>Ghế</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in completedBookings)
                                {
                                    var tickets = booking.Tickets
                                        .OrderBy(ticket => ticket.Seat?.SeatCode)
                                        .ToList();
                                    var showtime = tickets.FirstOrDefault()?.Showtime;
                                    var seatCodes = tickets
                                        .Select(ticket => ticket.Seat?.SeatCode)
                                        .Where(code => !string.IsNullOrWhiteSpace(code))
                                        .Distinct()
                                        .ToList();
                                    var ticketCodes = tickets
                                        .Select(ticket => ticket.TicketCode)
                                        .Where(code => !string.IsNullOrWhiteSpace(code))
                                        .ToList();
                                    var payment = booking.Payments
                                        .OrderByDescending(item => item.PaymentDate)
                                        .FirstOrDefault();

                                    <tr>
                                        <td>@(showtime?.Movie?.Title ?? "Không xác định")</td>
                                        <td>@(showtime?.Room?.RoomName ?? (showtime != null ? $"Phong {showtime.RoomID}" : "Không xác định"))</td>
                                        <td>
                                            @(showtime != null
                                                ? $"{showtime.Date:dd/MM/yyyy} - {showtime.StartTime:HH:mm}"
                                                : "Không xác định")
                                        </td>
                                        <td>@(seatCodes.Any() ? string.Join(", ", seatCodes) : "Không xác định")</td>
                                        <td>@booking.TotalAmount.ToString("C0", vi)</td>
                                        <td><span class="profile-status">@booking.Status</span></td>
                                        <td>
                                            <button type="button"
                                                    class="ticket-action"
                                                    data-ticket-detail
                                                    data-booking-id="#@booking.BookingID.ToString("D6")"
                                                    data-movie="@(showtime?.Movie?.Title ?? "Không xác định")"
                                                    data-room="@(showtime?.Room?.RoomName ?? (showtime != null ? $"Phong {showtime.RoomID}" : "Không xác định"))"
                                                    data-time="@(showtime != null ? $"{showtime.Date:dd/MM/yyyy} - {showtime.StartTime:HH:mm}" : "Không xác định")"
                                                    data-seats="@(seatCodes.Any() ? string.Join(", ", seatCodes) : "Không xác định")"
                                                    data-codes="@(ticketCodes.Any() ? string.Join(", ", ticketCodes) : "Không xác định")"
                                                    data-total="@booking.TotalAmount.ToString("C0", vi)"
                                                    data-payment="@(payment?.PaymentMethod?.MethodName ?? "Không xác định")"
                                                    data-status="@booking.Status">
                                                View Ticket
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="profile-empty">
                        Bạn chưa có vé đã hoàn tất. Sau khi thanh toán thành công, thông tin vé sẽ hiển thị tại đây.
                    </div>
                }
            </section>
        </div>
    </section>
</main>

<div class="profile-modal" id="editProfileModal" hidden>
    <form class="profile-modal__dialog" asp-action="Profile" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <div class="profile-modal__header">
            <div>
                <p class="profile-kicker">Thông tin cá nhân</p>
                <h2>Cập nhật hồ sơ</h2>
            </div>
            <button type="button" class="profile-modal__close" data-close-modal aria-label="Đóng">
                <i class="fa-solid fa-close"></i>
            </button>
        </div>
        <div class="profile-modal__body">
            @if (TempData["AlertError"] is string errorMessage)
            {
                <div class="profile-empty" role="alert">@errorMessage</div>
            }

            <div class="profile-form-grid">
                <div class="profile-field is-full">
                    <label asp-for="FullName">Họ và tên</label>
                    <input asp-for="FullName" id="profileFullName" />
                </div>
                <div class="profile-field is-full">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" readonly />
                </div>
                <div class="profile-field">
                    <label asp-for="PhoneNumber">Số điện thoại</label>
                    <input asp-for="PhoneNumber" />
                </div>
                <div class="profile-field">
                    <label asp-for="DOB">Ngày sinh</label>
                    <input asp-for="DOB" type="date" value="@(Model?.DOB?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>
        </div>
        <div class="profile-modal__footer">
            <button type="submit" class="profile-primary-button">Lưu thay đổi</button>
        </div>
    </form>
</div>

<div class="profile-modal" id="avatarMenuModal" hidden>
    <div class="profile-modal__dialog">
        <div class="profile-modal__header">
            <div>
                <p class="profile-kicker">ẢNH ĐẠI DIỆN</p>
                <h2>Đổi ảnh hồ sơ</h2>
            </div>
            <button type="button" class="profile-modal__close" data-close-modal aria-label="Dong">
                <i class="fa-solid fa-close"></i>
            </button>
        </div>
        <div class="profile-modal__body">
            <div class="profile-upload-actions">
                <button type="button" class="profile-primary-button" data-open-modal="avatarFileModal">Tải ảnh từ thiết bị</button>
                <button type="button" class="profile-secondary-button" data-open-modal="avatarLinkModal">Sử dụng ảnh từ liên kết</button>
            </div>
        </div>
    </div>
</div>

<div class="profile-modal" id="avatarFileModal" hidden>
    <form class="profile-modal__dialog" id="avatarFileForm">
        <div class="profile-modal__header">
            <div>
                <p class="profile-kicker">Cập nhật ảnh</p>
                <h2>Tải ảnh từ thiết bị</h2>
            </div>
            <button type="button" class="profile-modal__close" data-close-modal aria-label="Dong">
                <i class="fa-solid fa-close"></i>
            </button>
        </div>
        <div class="profile-modal__body">
            <div class="profile-field">
                <label for="avatarFileInput">CHỌN TỆP ẢNH</label>
                <input type="file" id="avatarFileInput" accept="image/*" />
            </div>
        </div>
        <div class="profile-modal__footer">
            <button type="submit" class="profile-primary-button">Cập nhật ảnh</button>
        </div>
    </form>
</div>

<div class="profile-modal" id="avatarLinkModal" hidden>
    <form class="profile-modal__dialog" id="avatarLinkForm">
        <div class="profile-modal__header">
            <div>
                <p class="profile-kicker">Cập nhật ảnh online</p>
                <h2>Nhập liên kết ảnh</h2>
            </div>
            <button type="button" class="profile-modal__close" data-close-modal aria-label="Dong">
                <i class="fa-solid fa-close"></i>
            </button>
        </div>
        <div class="profile-modal__body">
            <div class="profile-field">
                <label for="avatarLinkInput">URL ẢNH</label>
                <input type="url" id="avatarLinkInput" placeholder="https://..." />
            </div>
        </div>
        <div class="profile-modal__footer">
            <button type="submit" class="profile-primary-button">Cập nhật ảnh</button>
        </div>
    </form>
</div>

<div class="profile-modal" id="ticketDetailModal" hidden>
    <div class="profile-modal__dialog is-wide">
        <div class="profile-modal__header">
            <div>
                <p class="profile-kicker">Thông tin vé</p>
                <h2 id="ticketDetailTitle">Chi tiết</h2>
            </div>
            <button type="button" class="profile-modal__close" data-close-modal aria-label="Dong">
                <i class="fa-solid fa-close"></i>
            </button>
        </div>
        <div class="profile-modal__body">
            <div class="ticket-detail-grid">
                <div class="ticket-detail-row"><span>Mã booking</span><strong id="ticketBookingId"></strong></div>
                <div class="ticket-detail-row"><span>Phim</span><strong id="ticketMovie"></strong></div>
                <div class="ticket-detail-row"><span>Phòng</span><strong id="ticketRoom"></strong></div>
                <div class="ticket-detail-row"><span>Ngày / giờ</span><strong id="ticketTime"></strong></div>
                <div class="ticket-detail-row"><span>Ghế</span><strong id="ticketSeats"></strong></div>
                <div class="ticket-detail-row"><span>Mã vé</span><strong id="ticketCodes"></strong></div>
                <div class="ticket-detail-row"><span>Thanh toán</span><strong id="ticketPayment"></strong></div>
                <div class="ticket-detail-row"><span>Tổng tiền</span><strong id="ticketTotal"></strong></div>
                <div class="ticket-detail-row"><span>Trạng thái</span><strong id="ticketStatus"></strong></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const avatarStorageKey = 'cosmos.profile.avatar.@(Model?.UserID ?? 0)';
            const avatarButton = document.getElementById('profileAvatarButton');
            const avatarImage = document.getElementById('profileAvatarImage');
            const avatarInitial = document.getElementById('profileAvatarInitial');
            const fileInput = document.getElementById('avatarFileInput');
            const linkInput = document.getElementById('avatarLinkInput');

            function openModal(id) {
                document.getElementById(id)?.removeAttribute('hidden');
            }

            function closeModals() {
                document.querySelectorAll('.profile-modal').forEach(modal => {
                    modal.setAttribute('hidden', '');
                });
            }

            function setAvatar(src) {
                const navImages = document.querySelectorAll('[data-profile-avatar-image]');
                const navInitials = document.querySelectorAll('[data-profile-avatar-initial]');

                if (!src) {
                    avatarImage.removeAttribute('src');
                    avatarImage.style.display = 'none';
                    avatarInitial.style.display = 'block';
                    navImages.forEach(image => {
                        image.removeAttribute('src');
                        image.hidden = true;
                    });
                    navInitials.forEach(initial => {
                        initial.hidden = false;
                    });
                    return;
                }

                avatarImage.src = src;
                avatarImage.style.display = 'block';
                avatarInitial.style.display = 'none';
                navImages.forEach(image => {
                    image.src = src;
                    image.hidden = false;
                });
                navInitials.forEach(initial => {
                    initial.hidden = true;
                });
            }

            setAvatar(localStorage.getItem(avatarStorageKey));

            document.querySelectorAll('[data-open-modal]').forEach(button => {
                button.addEventListener('click', () => {
                    closeModals();
                    openModal(button.dataset.openModal);
                });
            });

            document.querySelectorAll('[data-close-modal]').forEach(button => {
                button.addEventListener('click', closeModals);
            });

            document.querySelectorAll('.profile-modal').forEach(modal => {
                modal.addEventListener('click', event => {
                    if (event.target === modal) {
                        closeModals();
                    }
                });
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    closeModals();
                }
            });

            avatarButton?.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    openModal('avatarMenuModal');
                }
            });

            document.getElementById('avatarFileForm')?.addEventListener('submit', event => {
                event.preventDefault();
                const file = fileInput?.files?.[0];
                if (!file) {
                    return;
                }

                const reader = new FileReader();
                reader.onload = () => {
                    const src = String(reader.result || '');
                    localStorage.setItem(avatarStorageKey, src);
                    setAvatar(src);
                    closeModals();
                    event.currentTarget.reset();
                };
                reader.readAsDataURL(file);
            });

            document.getElementById('avatarLinkForm')?.addEventListener('submit', event => {
                event.preventDefault();
                const src = linkInput.value.trim();
                if (!src) {
                    return;
                }

                localStorage.setItem(avatarStorageKey, src);
                setAvatar(src);
                closeModals();
                event.currentTarget.reset();
            });

            document.querySelectorAll('[data-ticket-detail]').forEach(button => {
                button.addEventListener('click', () => {
                    document.getElementById('ticketDetailTitle').textContent = button.dataset.movie || 'Chi tiet booking';
                    document.getElementById('ticketBookingId').textContent = button.dataset.bookingId || '';
                    document.getElementById('ticketMovie').textContent = button.dataset.movie || '';
                    document.getElementById('ticketRoom').textContent = button.dataset.room || '';
                    document.getElementById('ticketTime').textContent = button.dataset.time || '';
                    document.getElementById('ticketSeats').textContent = button.dataset.seats || '';
                    document.getElementById('ticketCodes').textContent = button.dataset.codes || '';
                    document.getElementById('ticketPayment').textContent = button.dataset.payment || '';
                    document.getElementById('ticketTotal').textContent = button.dataset.total || '';
                    document.getElementById('ticketStatus').textContent = button.dataset.status || '';
                    openModal('ticketDetailModal');
                });
            });
        });
    </script>
}
