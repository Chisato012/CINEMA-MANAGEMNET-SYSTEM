@model Cinema_Management.Models.LoginRequest
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Đăng nhập";

    var googleLoginEnabled =
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-wrapper auth-page-login">
    <div class="auth-shell max-w-7xl mx-auto">

        <div class="auth-form-panel">
            <div class="auth-form-heading">
                <p class="auth-form-kicker">COSMOS CINEMA</p>
                <h2>Chào mừng trở lại</h2>
                <p>Nhập email và mật khẩu để tiếp tục.</p>
            </div>

            <div class="auth-tabs" role="tablist" aria-label="Chuyển chế độ tài khoản">
                <a class="auth-tab active" asp-controller="Account" asp-action="Login" aria-current="page">Đăng nhập</a>
                <a class="auth-tab" asp-controller="Account" asp-action="Register">Đăng ký</a>
            </div>

            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

            <form class="auth-form" asp-controller="Account" asp-action="Login" method="post">
                <div class="auth-field">
                    <label asp-for="Email" class="auth-label">Địa chỉ email</label>
                    <div class="auth-input-frame">
                        <span class="auth-input-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path
                                d="M4.75 6.75A2.75 2.75 0 0 1 7.5 4h9A2.75 2.75 0 0 1 19.25 6.75v10.5A2.75 2.75 0 0 1 16.5 20h-9a2.75 2.75 0 0 1-2.75-2.75V6.75Zm2.75-1.25A1.25 1.25 0 0 0 6.25 6.75v.55l5.18 3.31c.35.22.79.22 1.14 0l5.18-3.31v-.55A1.25 1.25 0 0 0 16.5 5.5h-9Zm10.25 3.58-4.38 2.8a2.62 2.62 0 0 1-2.74 0l-4.38-2.8v8.17c0 .69.56 1.25 1.25 1.25h9c.69 0 1.25-.56 1.25-1.25V9.08Z" />
                            </svg>
                        </span>
                        <input asp-for="Email" type="email" id="email-input" class="form-control auth-input"
                               autocomplete="email" placeholder="you@example.com"
                               aria-describedby="email-helper email-error" />
                    </div>
                    <small id="email-helper" class="auth-helper">Dùng email đã đăng ký tài khoản COSMOS.</small>
                    <small id="email-error" class="auth-field-error"></small>
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <div class="auth-label-row">
                        <label asp-for="Password" class="auth-label">Mật khẩu</label>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-link">Quên mật khẩu?</a>
                    </div>
                    <div class="auth-input-frame">
                        <span class="auth-input-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path
                                d="M8.75 10V7.75a3.25 3.25 0 0 1 6.5 0V10h.5A2.25 2.25 0 0 1 18 12.25v5.5A2.25 2.25 0 0 1 15.75 20h-7.5A2.25 2.25 0 0 1 6 17.75v-5.5A2.25 2.25 0 0 1 8.25 10h.5Zm1.5 0h3.5V7.75a1.75 1.75 0 0 0-3.5 0V10Zm-2.75 2.25v5.5c0 .41.34.75.75.75h7.5c.41 0 .75-.34.75-.75v-5.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0-.75.75Z" />
                            </svg>
                        </span>
                        @if (ViewBag.ShowDevelopmentPasswordlessLoginMessage == true)
                        {
                            <input type="password" id="passwordInput" name="Password" class="form-control auth-input"
                                   autocomplete="current-password" value="@Model?.Password"
                                   aria-describedby="password-error" />
                        }
                        else
                        {
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control auth-input"
                                   autocomplete="current-password" aria-describedby="password-error" />
                        }
                        <button class="auth-password-toggle" id="togglePassword" type="button"
                                aria-label="Hiện hoặc ẩn mật khẩu">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
                                <path
                                d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755l.192.195z" />
                                <path
                                d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822Zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z" />
                                <path
                                d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709Zm10.296 8.884-12-12 .708-.708 12 12-.708.708z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="auth-field-error"></span>
                </div>

                @* <div class="auth-turnstile">
                    <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey" data-theme="dark">
                    </div>

                    @if (ViewBag.CaptchaError != null)
                    {
                        <span class="auth-field-error">@ViewBag.CaptchaError</span>
                    }
                </div> *@

                <label class="auth-check">
                    <input type="checkbox" id="RememberMe" class="form-check-input" asp-for="RememberMe" />
                    <span>Ghi nhớ thiết bị này</span>
                </label>

                <button type="submit" class="btn btn-submit">Đăng nhập</button>
            </form>

            @if (ViewBag.UnconfirmedEmail != null)
            {
                <form asp-controller="Account" asp-action="ResendConfirmationEmail" method="post" class="auth-resend-form">
                    <input type="hidden" name="email" value="@ViewBag.UnconfirmedEmail" />
                    <button type="submit" class="btn-resend-confirmation">Gửi lại email xác nhận</button>
                </form>
            }

            <p class="auth-switch-copy">
                Chưa có tài khoản?
                <a asp-controller="Account" asp-action="Register">Tạo tài khoản mới</a>
            </p>

            @if (googleLoginEnabled)
            {
                <div class="auth-divider">
                    <span>Hoặc tiếp tục với</span>
                </div>

                <a id="googleLoginBtn" class="btn btn-google-login" asp-controller="Account" asp-action="GoogleLogin">
                    <svg class="google-logo" viewBox="0 0 48 48" aria-hidden="true">
                        <path fill="#EA4335"
                              d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.6 2.6 30.3.2 24 .2 14.6.2 6.5 5.6 2.6 13.5l7.8 6.1C12.2 13.7 17.7 9.5 24 9.5z" />
                        <path fill="#4285F4"
                              d="M46.5 24.5c0-1.7-.2-3.4-.5-5H24v9.5h12.6c-.5 3-2.2 5.5-4.7 7.2l7.3 5.7c4.3-4 7.3-9.8 7.3-17.4z" />
                        <path fill="#FBBC05"
                              d="M10.4 28.4c-.5-1.4-.8-2.9-.8-4.4s.3-3 .8-4.4l-7.8-6.1C1 16.7.2 20.2.2 24s.8 7.3 2.4 10.5l7.8-6.1z" />
                        <path fill="#34A853"
                              d="M24 47.8c6.3 0 11.6-2.1 15.5-5.8l-7.3-5.7c-2 1.3-4.6 2.1-8.2 2.1-6.3 0-11.8-4.2-13.6-10l-7.8 6.1C6.5 42.4 14.6 47.8 24 47.8z" />
                    </svg>
                    <span>Tiếp tục với Google</span>
                </a>
            }
        </div>
    </div>
</section>

<script src="~/js/auth.js" asp-append-version="true"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    @if (googleLoginEnabled)
    {
        <script>
            document.getElementById('googleLoginBtn')?.addEventListener('click', function () {
                const rememberMe = document.getElementById('RememberMe')?.checked || false;
                this.href = '@Url.Action("GoogleLogin", "Account")?rememberMe=' + rememberMe;
            });
        </script>
    }
}
