@model Cinema_Management.Models.ResetPasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Dat lai mat khau";
}

<div class="auth-container" style="background:#121212; color:#fff; max-width:500px; margin:80px auto; padding:30px; border-radius:8px;">
    <h3 style="color:#D4A373; text-align:center; margin-bottom:10px;">DAT LAI MAT KHAU</h3>
    <p style="color:#aaa; font-size:13px; text-align:center; margin-bottom:24px;">
        Tao mat khau moi cho tai khoan COSMOS Cinema cua ban.
    </p>

    <form asp-action="ResetPassword" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div asp-validation-summary="ModelOnly" style="color:#ff4d4d; font-size:12px; margin-bottom:12px;"></div>

        <div style="margin-bottom:15px;">
            <label asp-for="Password" style="display:block; font-size:12px; color:#aaa; margin-bottom:6px; font-weight:bold;">MAT KHAU MOI</label>
            <input asp-for="Password" type="password" autocomplete="new-password" style="width:100%; padding:12px; background:#222; border:1px solid #444; color:#fff; border-radius:4px;" />
            <span asp-validation-for="Password" style="color:#ff4d4d; font-size:12px; display:block; margin-top:5px;"></span>
        </div>

        <div style="margin-bottom:24px;">
            <label asp-for="ConfirmPassword" style="display:block; font-size:12px; color:#aaa; margin-bottom:6px; font-weight:bold;">NHAP LAI MAT KHAU</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" style="width:100%; padding:12px; background:#222; border:1px solid #444; color:#fff; border-radius:4px;" />
            <span asp-validation-for="ConfirmPassword" style="color:#ff4d4d; font-size:12px; display:block; margin-top:5px;"></span>
        </div>

        <button type="submit" style="width:100%; padding:14px; background:#A67B5B; color:#fff; border:none; border-radius:6px; font-weight:bold; cursor:pointer; text-transform:uppercase;">
            CAP NHAT MAT KHAU
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
