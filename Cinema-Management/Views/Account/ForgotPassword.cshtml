@model Cinema_Management.Models.ForgotPasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quen mat khau";
}

<div class="auth-container" style="background:#121212; color:#fff; max-width:500px; margin:80px auto; padding:30px; border-radius:8px;">
    <h3 style="color:#D4A373; text-align:center; margin-bottom:10px;">QUEN MAT KHAU</h3>
    <p style="color:#aaa; font-size:13px; text-align:center; margin-bottom:24px;">
        Nhap email tai khoan local de nhan lien ket dat lai mat khau.
    </p>

    @if (ViewBag.StatusMessage != null)
    {
        <div style="background:#1f3324; border:1px solid #2f7d3b; color:#d8f3dc; padding:12px; border-radius:4px; margin-bottom:16px;">
            @ViewBag.StatusMessage
        </div>
    }

    <form asp-action="ForgotPassword" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:#ff4d4d; font-size:12px; margin-bottom:12px;"></div>

        <div style="margin-bottom:20px;">
            <label asp-for="Email" style="display:block; font-size:12px; color:#aaa; margin-bottom:6px; font-weight:bold;">EMAIL</label>
            <input asp-for="Email" type="email" autocomplete="email" style="width:100%; padding:12px; background:#222; border:1px solid #444; color:#fff; border-radius:4px;" />
            <span asp-validation-for="Email" style="color:#ff4d4d; font-size:12px; display:block; margin-top:5px;"></span>
        </div>

        <button type="submit" style="width:100%; padding:14px; background:#A67B5B; color:#fff; border:none; border-radius:6px; font-weight:bold; cursor:pointer; text-transform:uppercase;">
            GUI LIEN KET DAT LAI
        </button>
    </form>

    <div style="text-align:center; margin-top:18px;">
        <a asp-action="Login" asp-controller="Account" style="color:#D4A373; text-decoration:none;">Quay lai dang nhap</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
