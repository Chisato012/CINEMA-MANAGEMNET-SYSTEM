@model List<Cinema_Management.Models.MovieViewModel>
@using System.Globalization
@using System.Text


@* Quang UI *@
@{
    ViewData["Title"] = "Movies";
    ViewData["HideDefaultFooter"] = true;

    var today = DateTime.Today;
    var movies = (Model ?? new List<MovieViewModel>())
        .Where(movie => movie != null)
        .ToList();

    var nowShowing = movies
        .Where(movie => movie.ReleaseDate.Date <= today)
        .Take(10)
        .ToList();

    if (!nowShowing.Any())
    {
        nowShowing = movies.Take(10).ToList();
    }

    var allNowShowing = ViewBag.AllNowShowingMovies as List<MovieViewModel> ?? new List<MovieViewModel>();
    if (!allNowShowing.Any())
    {
        allNowShowing = nowShowing;
    }

    var allComingSoon = ViewBag.AllComingSoonMovies as List<MovieViewModel> ?? new List<MovieViewModel>();
    var comingSoon = allComingSoon.Take(5).ToList();

    var rankingMovies = allNowShowing
        .Concat(allComingSoon)
        .Concat(movies)
        .Where(movie => movie != null)
        .GroupBy(movie => movie.MovieId)
        .Select(group => group.First())
        .ToList();

    var topRated = rankingMovies
        .OrderByDescending(movie => movie.AverageRating)
        .ThenByDescending(movie => movie.ReviewCount)
        .ThenBy(movie => movie.Title)
        .Take(5)
        .ToList();

    var heroSlides = movies.Take(4).ToList();

    var featured = topRated.FirstOrDefault() ?? movies.FirstOrDefault();
    var suggestions = topRated.Skip(1).Concat(movies).GroupBy(movie => movie.MovieId).Select(group => group.First()).Take(3).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/movie.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
}

<div class="movies-page">
    <section class="movie-shell movie-hero" aria-label="Featured movies">
        @if (heroSlides.Any())
        {
            <div class="movie-hero__viewport">
                @for (var index = 0; index < heroSlides.Count; index++)
                {
                    var slide = heroSlides[index];
                    var firstFutureShowtime = slide.Showtimes?
                        .Where(showtime => showtime.Date.Date >= today)
                        .OrderBy(showtime => showtime.Date)
                        .ThenBy(showtime => showtime.StartTime)
                        .FirstOrDefault();
                    var activeClass = index == 0 ? "is-active" : string.Empty;

                    <article class="movie-hero__slide @activeClass" style="--hero-poster: url('@Poster(slide)');">
                        <div class="movie-hero__content">
                            <p class="movie-eyebrow @HeroStatusClass(slide, today)">@HeroStatusLabel(slide, today)</p>
                            <h1>@Safe(slide.Title, "Tonight at COSMOS")</h1>
                            <p class="movie-hero__tagline">@Clamp(slide.Synopsis, 132)</p>

                            <div class="movie-hero__meta" aria-label="Movie metadata">
                                <span>@Safe(slide.Genre, "Cinema pick")</span>
                                <span>@DurationLabel(slide)</span>
                                <span>@HeroDateLabel(slide, today)</span>
                            </div>

                            <div class="movie-hero__actions">
                                @if (IsUpcoming(slide, today))
                                {
                                    <a class="movie-btn movie-btn--primary" asp-controller="Home" asp-action="Details" asp-route-id="@slide.MovieId">
                                        <i class="fa-solid fa-circle-info"></i>
                                        Chi tiết
                                    </a>
                                }
                                else
                                {
                                    <form asp-controller="Booking" asp-action="SelectShowtime" method="get">
                                        <input type="hidden" name="movieId" value="@slide.MovieId" />
                                        @if (firstFutureShowtime != null)
                                        {
                                            <input type="hidden" name="showtimeId" value="@firstFutureShowtime.ShowtimeID" />
                                        }
                                        <button type="submit" class="movie-btn movie-btn--primary">
                                            <i class="fa-solid fa-ticket"></i>
                                            Đặt vé
                                        </button>
                                    </form>
                                }

                                @if (!string.IsNullOrWhiteSpace(slide.Trailer))
                                {
                                    <button type="button"
                                            class="movie-btn movie-btn--ghost"
                                            data-trailer-trigger
                                            data-trailer-url="@slide.Trailer">
                                        <i class="fa-solid fa-play"></i>
                                        Xem trailer
                                    </button>
                                }
                                else
                                {
                                    <a class="movie-btn movie-btn--ghost" asp-controller="Home" asp-action="Details" asp-route-id="@slide.MovieId">
                                        <i class="fa-solid fa-circle-info"></i>
                                        Chi tiết 
                                    </a>
                                }
                            </div>
                        </div>

                        <a class="movie-hero__poster" asp-controller="Home" asp-action="Details" asp-route-id="@slide.MovieId" aria-label="View @slide.Title details">
                            <img src="@Poster(slide)" alt="@Safe(slide.Title, "Movie") poster" />
                        </a>
                    </article>
                }
            </div>

            <button type="button" class="movie-hero__arrow movie-hero__arrow--prev" data-hero-prev aria-label="Previous featured movie">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="movie-hero__arrow movie-hero__arrow--next" data-hero-next aria-label="Next featured movie">
                <i class="fa-solid fa-chevron-right"></i>
            </button>

            <div class="movie-hero__dots" aria-label="Featured movie slides">
                @for (var index = 0; index < heroSlides.Count; index++)
                {
                    <button type="button" class="movie-hero__dot @(index == 0 ? "is-active" : string.Empty)" data-hero-dot="@index" aria-label="Go to featured movie @(index + 1)"></button>
                }
            </div>
        }
        else
        {
            <div class="movie-empty movie-empty--hero">
                <p class="movie-eyebrow">Movies</p>
                <h1>No movies are available yet.</h1>
                <p>Once the database has movie records, this page will populate automatically.</p>
            </div>
        }
    </section>

    <section class="movie-shell movie-filter" aria-labelledby="movie-filter-title">
        <div class="movie-filter__intro">
            <span class="movie-section-mark" aria-hidden="true"></span>
            <h2 id="movie-filter-title">Khám phá theo<br /><span>tâm trạng và thể loại</span></h2>
        </div>

        <label class="movie-search" for="movieSearch">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="movieSearch" type="search" placeholder="Tìm kiếm" autocomplete="off" />
        </label>

        <div class="movie-filter__chips" aria-label="Movie categories">
            <button type="button" class="genre-chip is-active" data-filter="all"><i class="fa-solid fa-border-all"></i>Tất cả</button>
            <button type="button" class="genre-chip" data-filter="action"><i class="fa-solid fa-bolt"></i>Hành động</button>
            <button type="button" class="genre-chip" data-filter="romance"><i class="fa-regular fa-heart"></i>Lãng mạn</button>
            <button type="button" class="genre-chip" data-filter="sci-fi"><i class="fa-solid fa-atom"></i>Khoa học viễn tưởng</button>
            <button type="button" class="genre-chip" data-filter="horror"><i class="fa-solid fa-ghost"></i>Kinh dị</button>
            <button type="button" class="genre-chip" data-filter="animation"><i class="fa-solid fa-film"></i>Hoạt hình</button>
            <button type="button" class="genre-chip" data-filter="comedy"><i class="fa-regular fa-face-smile"></i>Hài hước</button>
            <button type="button" class="genre-chip" data-filter="drama"><i class="fa-solid fa-masks-theater"></i>Kịch</button>
            <button type="button" class="genre-chip" data-filter="family"><i class="fa-solid fa-people-group"></i>Gia đình</button>
        </div>
    </section>

    <section class="movie-shell movie-section" aria-labelledby="now-showing-title">
        <div class="movie-section__header">
            <div>
                <h2 id="now-showing-title">Phim Đang Chiếu</h2>
                <p>Hiện đang chiếu hôm nay.</p>
            </div>
            <button type="button" class="movie-btn movie-btn--outline" data-movie-list-open data-movie-list-target="nowShowingModal">Xem tất cả <i class="fa-solid fa-chevron-right"></i></button>
        </div>

        @if (nowShowing.Any())
        {
            <div class="movie-card-grid movie-card-grid--wide">
                @foreach (var movie in nowShowing.Take(5))
                {
                    var firstFutureShowtime = movie.Showtimes?
                        .Where(showtime => showtime.Date.Date >= today)
                        .OrderBy(showtime => showtime.Date)
                        .ThenBy(showtime => showtime.StartTime)
                        .FirstOrDefault();

                    <article class="movie-card" data-movie-card data-title="@Safe(movie.Title, string.Empty).ToLowerInvariant()" data-genres="@GenreData(movie)">
                        <a class="movie-card__poster" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">
                            <img src="@Poster(movie)" alt="@Safe(movie.Title, "Movie") poster" />
                        </a>
                        <div class="movie-card__body">
                            <a class="movie-card__title" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">@Safe(movie.Title, "Untitled movie")</a>
                            <p>@MovieMeta(movie)</p>
                            <div class="movie-card__rating">
                                @if (!string.IsNullOrWhiteSpace(movie.AgeRating))
                                {
                                    <span class="movie-age">@movie.AgeRating</span>
                                }
                                <span class="movie-review-score"><i class="fa-solid fa-star"></i>@ReviewScoreLabel(movie)</span>
                            </div>
                            @if (IsUpcoming(movie, today))
                            {
                                <a class="movie-card__button movie-card__button--outline" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">Chi tiết</a>
                            }
                            else
                            {
                                <form asp-controller="Booking" asp-action="SelectShowtime" method="get">
                                    <input type="hidden" name="movieId" value="@movie.MovieId" />
                                    @if (firstFutureShowtime != null)
                                    {
                                        <input type="hidden" name="showtimeId" value="@firstFutureShowtime.ShowtimeID" />
                                    }
                                    <button type="submit" class="movie-card__button">Đặt vé</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="movie-empty">There are no now showing movies yet.</p>
        }
    </section>

    <section class="movie-shell movie-section" aria-labelledby="coming-soon-title">
        <div class="movie-section__header movie-section__header--large">
            <div>
                <h2 id="coming-soon-title">Coming Soon</h2>
                <p>Những phim mới sắp ra mắt.</p>
            </div>
            <button type="button" class="movie-btn movie-btn--outline" data-movie-list-open data-movie-list-target="comingSoonModal">View all coming soon <i class="fa-solid fa-chevron-right"></i></button>
        </div>

        @if (comingSoon.Any())
        {
            <div class="movie-card-grid movie-card-grid--wide">
                @foreach (var movie in comingSoon.Take(5))
                {
                    <article class="movie-card movie-card--coming" data-movie-card data-title="@Safe(movie.Title, string.Empty).ToLowerInvariant()" data-genres="@GenreData(movie)">
                        <a class="movie-card__poster" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">
                            <img src="@Poster(movie)" alt="@Safe(movie.Title, "Movie") poster" />
                        </a>
                        <div class="movie-card__body">
                            <span class="movie-date-badge"><i class="fa-regular fa-calendar"></i>@DateLabel(movie.ReleaseDate)</span>
                            <a class="movie-card__title" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">@Safe(movie.Title, "Untitled movie")</a>
                            <p>@Safe(movie.Genre, "Coming soon")</p>
                            <a class="movie-card__button movie-card__button--outline" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">
                                Chi tiết
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="movie-empty">Hiện tại chưa có phim nào sắp được ra mắt.</p>
        }
    </section>

    <section class="movie-shell top-rated" aria-labelledby="top-rated-title">
        <div class="top-rated__header">
            <h2 id="top-rated-title">Xếp hạng <span>Phim phổ biến</span></h2>
        </div>

        @if (featured != null)
        {
            <div class="top-rated__layout" data-ranking-carousel>
                <div class="rank-list" aria-label="Movie ranking by star rating">
                    @for (var index = 0; index < topRated.Count; index++)
                    {
                        var movie = topRated[index];
                        <a class="rank-row @(index == 0 ? "is-active" : string.Empty)"
                           asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@movie.MovieId"
                           data-rank-row="@index"
                           data-title="@Safe(movie.Title, string.Empty).ToLowerInvariant()"
                           data-genres="@GenreData(movie)"
                           aria-current="@(index == 0 ? "true" : "false")">
                            <span class="rank-row__number">@(index + 1)</span>
                            <img src="@Poster(movie)" alt="@Safe(movie.Title, "Movie") poster" />
                            <span class="rank-row__copy">
                                <strong>@Safe(movie.Title, "Untitled movie")</strong>
                                <small>@Safe(movie.Genre, "Cinema pick")</small>
                            </span>
                            <span class="rank-row__score"><i class="fa-solid fa-star"></i>@ReviewScoreLabel(movie)</span>
                        </a>
                    }
                </div>

                <div class="featured-card-stack">
                    @for (var index = 0; index < topRated.Count; index++)
                    {
                        var rankedMovie = topRated[index];

                        <article class="featured-card @(index == 0 ? "is-active" : string.Empty)" data-rank-feature="@index" aria-hidden="@(index == 0 ? "false" : "true")">
                            <div class="featured-card__media" style="--featured-poster: url('@Poster(rankedMovie)');">
                                <img src="@Poster(rankedMovie)" alt="@Safe(rankedMovie.Title, "Movie") poster" />
                                <div class="featured-card__score">
                                    <i class="fa-solid fa-star" aria-hidden="true"></i>
                                    <span>@ReviewAverageLabel(rankedMovie)<small>@ReviewCountLabel(rankedMovie)</small></span>
                                </div>
                            </div>
                            <div class="featured-card__body">
                                <h3>@Safe(rankedMovie.Title, "COSMOS pick")</h3>
                                <p class="featured-card__meta">@MovieMeta(rankedMovie)</p>
                                <p>@Clamp(rankedMovie.Synopsis, 190)</p>
                                <div class="featured-card__actions">
                                    <a class="movie-btn movie-btn--primary" asp-controller="Home" asp-action="Details" asp-route-id="@rankedMovie.MovieId">
                                        <i class="fa-solid fa-play"></i>
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
        else
        {
            <p class="movie-empty">Các bộ phim được đánh giá cao nhất sẽ xuất hiện sau khi có dữ liệu phim khả dụng.</p>
        }
    </section>

    

    
    <div class="movie-list-modal" id="nowShowingModal" aria-hidden="true">
        <div class="movie-list-modal__panel" role="dialog" aria-modal="true" aria-labelledby="nowShowingModalTitle">
            <div class="movie-list-modal__header">
                <div>
                    <span class="movie-eyebrow">COSMOS Cinema</span>
                    <h2 id="nowShowingModalTitle">Phim đang chiếu</h2>
                    <p>@allNowShowing.Count phim đang có lịch chiếu hoặc đã phát hành tại COSMOS.</p>
                </div>
                <button type="button" class="movie-list-modal__close" data-movie-list-close aria-label="Đóng danh sách phim">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>

            <div class="movie-list-modal__body">
                @if (allNowShowing.Any())
                {
                    <div class="movie-list-modal__grid">
                        @foreach (var movie in allNowShowing)
                        {
                            var firstFutureShowtime = movie.Showtimes?
                                .Where(showtime => showtime.Date.Date >= today)
                                .OrderBy(showtime => showtime.Date)
                                .ThenBy(showtime => showtime.StartTime)
                                .FirstOrDefault();

                            <article class="movie-card movie-card--modal" data-title="@Safe(movie.Title, string.Empty).ToLowerInvariant()" data-genres="@GenreData(movie)">
                                <a class="movie-card__poster" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">
                                    <img src="@Poster(movie)" alt="@Safe(movie.Title, "Movie") poster" loading="lazy" />
                                </a>
                                <div class="movie-card__body">
                                    <a class="movie-card__title" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">@Safe(movie.Title, "Untitled movie")</a>
                                    <p>@MovieMeta(movie)</p>
                                    <div class="movie-card__rating">
                                        @if (!string.IsNullOrWhiteSpace(movie.AgeRating))
                                        {
                                            <span class="movie-age">@movie.AgeRating</span>
                                        }
                                        <span class="movie-review-score"><i class="fa-solid fa-star"></i>@ReviewScoreLabel(movie)</span>
                                        @if (firstFutureShowtime != null)
                                        {
                                            <span><i class="fa-regular fa-clock"></i>@firstFutureShowtime.StartTime.ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                                        }
                                    </div>
                                    @if (IsUpcoming(movie, today))
                                    {
                                        <a class="movie-card__button movie-card__button--outline" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">Chi tiết</a>
                                    }
                                    else
                                    {
                                        <form asp-controller="Booking" asp-action="SelectShowtime" method="get">
                                            <input type="hidden" name="movieId" value="@movie.MovieId" />
                                            @if (firstFutureShowtime != null)
                                            {
                                                <input type="hidden" name="showtimeId" value="@firstFutureShowtime.ShowtimeID" />
                                            }
                                            <button type="submit" class="movie-card__button">Đặt vé</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="movie-list-modal__empty">
                        <i class="fa-regular fa-calendar-xmark" aria-hidden="true"></i>
                        <h3>Chưa có phim đang chiếu</h3>
                        <p>Lịch chiếu sẽ được cập nhật khi có dữ liệu mới từ hệ thống.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="movie-list-modal" id="comingSoonModal" aria-hidden="true">
        <div class="movie-list-modal__panel" role="dialog" aria-modal="true" aria-labelledby="comingSoonModalTitle">
            <div class="movie-list-modal__header">
                <div>
                    <span class="movie-eyebrow movie-eyebrow--upcoming">COSMOS Cinema</span>
                    <h2 id="comingSoonModalTitle">Phim sắp chiếu</h2>
                    <p>Có @allComingSoon.Count phim sắp được khởi chiếu tại rạp.</p>
                </div>
                <button type="button" class="movie-list-modal__close" data-movie-list-close aria-label="Đóng danh sách phim sắp chiếu">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>

            <div class="movie-list-modal__body">
                @if (allComingSoon.Any())
                {
                    <div class="movie-list-modal__grid">
                        @foreach (var movie in allComingSoon)
                        {
                            <article class="movie-card movie-card--coming movie-card--modal" data-title="@Safe(movie.Title, string.Empty).ToLowerInvariant()" data-genres="@GenreData(movie)">
                                <a class="movie-card__poster" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">
                                    <img src="@Poster(movie)" alt="@Safe(movie.Title, "Movie") poster" loading="lazy" />
                                </a>
                                <div class="movie-card__body">
                                    <span class="movie-date-badge"><i class="fa-regular fa-calendar"></i>@DateLabel(movie.ReleaseDate)</span>
                                    <a class="movie-card__title" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">@Safe(movie.Title, "Untitled movie")</a>
                                    <p>@Safe(movie.Genre, "Coming soon")</p>
                                    <a class="movie-card__button movie-card__button--outline" asp-controller="Home" asp-action="Details" asp-route-id="@movie.MovieId">Chi tiết</a>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="movie-list-modal__empty">
                        <i class="fa-regular fa-calendar-xmark" aria-hidden="true"></i>
                        <h3>Chưa có phim sắp chiếu</h3>
                        <p>Các phim mới sẽ xuất hiện tại đây khi có ngày khởi chiếu trong hệ thống.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="trailer-modal" id="trailerModal" aria-hidden="true">
        <div class="trailer-modal__content" role="dialog" aria-modal="true" aria-label="Trailer phim">
            <button type="button" class="trailer-modal__close" data-trailer-close aria-label="Đóng trailer">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
            <iframe id="trailerIframe"
                    title="Trailer phim"
                    src=""
                    allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
            </iframe>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            let activeTrigger = null;

            const openModal = (modal, trigger, event) => {
                event?.preventDefault();
                activeTrigger = trigger;

                modal.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                modal.querySelector('[data-movie-list-close]')?.focus();
            };

            const closeModal = (modal) => {
                if (!modal?.classList.contains('active')) {
                    return;
                }

                modal.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
                activeTrigger?.focus();
                activeTrigger = null;
            };

            document.querySelectorAll('[data-movie-list-open]').forEach((trigger) => {
                trigger.addEventListener('click', (event) => {
                    const targetId = trigger.dataset.movieListTarget;
                    const modal = targetId ? document.getElementById(targetId) : null;

                    if (modal) {
                        openModal(modal, trigger, event);
                    }
                });
            });

            document.querySelectorAll('.movie-list-modal').forEach((modal) => {
                modal.querySelectorAll('[data-movie-list-close]').forEach((button) => {
                    button.addEventListener('click', () => closeModal(modal));
                });

                modal.addEventListener('click', (event) => {
                    if (event.target === modal) {
                        closeModal(modal);
                    }
                });
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    document.querySelectorAll('.movie-list-modal.active').forEach((modal) => closeModal(modal));
                }
            });
        })();

        function getEmbedUrl(url) {
            if (!url) return '';

            let match = url.match(/youtu\.be\/([a-zA-Z0-9_-]+)/);
            if (match) return 'https://www.youtube.com/embed/' + match[1] + '?autoplay=1';

            match = url.match(/[?&]v=([a-zA-Z0-9_-]+)/);
            if (match) return 'https://www.youtube.com/embed/' + match[1] + '?autoplay=1';

            match = url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]+)/);
            if (match) return 'https://www.youtube.com/embed/' + match[1] + '?autoplay=1';

            return url;
        }

        function openTrailer(trailerUrl) {
            const modal = document.getElementById('trailerModal');
            const iframe = document.getElementById('trailerIframe');

            if (!trailerUrl || !modal || !iframe) {
                return;
            }

            iframe.src = getEmbedUrl(trailerUrl);
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        function closeTrailer() {
            const modal = document.getElementById('trailerModal');
            const iframe = document.getElementById('trailerIframe');

            if (!modal || !iframe) {
                return;
            }

            iframe.src = '';
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        (() => {
            const modal = document.getElementById('trailerModal');

            document.querySelectorAll('[data-trailer-trigger]').forEach((button) => {
                button.addEventListener('click', () => openTrailer(button.dataset.trailerUrl));
            });

            document.querySelectorAll('[data-trailer-close]').forEach((button) => {
                button.addEventListener('click', closeTrailer);
            });

            modal?.addEventListener('click', (event) => {
                if (event.target === modal) {
                    closeTrailer();
                }
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    closeTrailer();
                }
            });
        })();

        (() => {
            const slides = Array.from(document.querySelectorAll('.movie-hero__slide'));
            const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
            const previous = document.querySelector('[data-hero-prev]');
            const next = document.querySelector('[data-hero-next]');
            let current = 0;

            if (!slides.length) return;

            const showSlide = (index) => {
                current = (index + slides.length) % slides.length;
                slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === current));
                dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === current));
            };

            previous?.addEventListener('click', () => showSlide(current - 1));
            next?.addEventListener('click', () => showSlide(current + 1));
            dots.forEach((dot) => dot.addEventListener('click', () => showSlide(Number(dot.dataset.heroDot))));

            if (slides.length > 1) {
                window.setInterval(() => showSlide(current + 1), 7000);
            }
        })();

        (() => {
            const carousel = document.querySelector('[data-ranking-carousel]');
            if (!carousel) return;

            const rows = Array.from(carousel.querySelectorAll('[data-rank-row]'));
            const features = Array.from(carousel.querySelectorAll('[data-rank-feature]'));
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            let current = 0;
            let timer = null;

            if (rows.length <= 1 || features.length <= 1) return;

            const showRank = (index) => {
                current = (index + rows.length) % rows.length;

                rows.forEach((row, rowIndex) => {
                    const isActive = rowIndex === current;
                    row.classList.toggle('is-active', isActive);
                    row.setAttribute('aria-current', isActive ? 'true' : 'false');
                });

                features.forEach((feature, featureIndex) => {
                    const isActive = featureIndex === current;
                    feature.classList.toggle('is-active', isActive);
                    feature.setAttribute('aria-hidden', isActive ? 'false' : 'true');
                });
            };

            const stop = () => {
                if (timer) {
                    window.clearInterval(timer);
                    timer = null;
                }
            };

            const start = () => {
                if (reduceMotion.matches) return;
                stop();
                timer = window.setInterval(() => showRank(current + 1), 3000);
            };

            rows.forEach((row, rowIndex) => {
                row.addEventListener('mouseenter', () => {
                    stop();
                    showRank(rowIndex);
                });
                row.addEventListener('focus', () => {
                    stop();
                    showRank(rowIndex);
                });
            });

            carousel.addEventListener('mouseleave', start);
            carousel.addEventListener('focusout', (event) => {
                if (!carousel.contains(event.relatedTarget)) {
                    start();
                }
            });
            document.addEventListener('visibilitychange', () => {
                document.hidden ? stop() : start();
            });

            showRank(0);
            start();
        })();

        (() => {
            const chips = Array.from(document.querySelectorAll('.genre-chip'));
            const search = document.querySelector('#movieSearch');
            const cards = Array.from(document.querySelectorAll('[data-movie-card], .rank-row'));
            let activeFilter = 'all';

            const applyFilters = () => {
                const query = (search?.value || '').trim().toLowerCase();

                cards.forEach((card) => {
                    const title = card.dataset.title || '';
                    const genres = card.dataset.genres || '';
                    const matchesGenre = activeFilter === 'all' || genres.includes(activeFilter);
                    const matchesSearch = !query || title.includes(query) || genres.includes(query);
                    card.classList.toggle('is-hidden', !(matchesGenre && matchesSearch));
                });
            };

            chips.forEach((chip) => {
                chip.addEventListener('click', () => {
                    chips.forEach((item) => item.classList.remove('is-active'));
                    chip.classList.add('is-active');
                    activeFilter = chip.dataset.filter || 'all';
                    applyFilters();
                });
            });

            search?.addEventListener('input', applyFilters);
        })();

        (() => {
            const moodButtons = Array.from(document.querySelectorAll('.mood-chip'));
            const cards = Array.from(document.querySelectorAll('[data-suggestion-card]'));
            const input = document.querySelector('#moodInput');
            const findButton = document.querySelector('[data-find-movie]');

            const moodMap = {
                cozy: ['family', 'animation', 'comedy', 'romance'],
                thrilling: ['action', 'thriller', 'horror'],
                funny: ['comedy', 'animation', 'family'],
                romantic: ['romance', 'drama'],
                mind: ['sci-fi', 'mystery', 'thriller']
            };

            const applyMood = (mood) => {
                const preferred = moodMap[mood] || [];
                cards.forEach((card) => {
                    const genres = card.dataset.genres || '';
                    const isMatch = preferred.some((genre) => genres.includes(genre));
                    card.classList.toggle('is-soft', preferred.length > 0 && !isMatch);
                });
            };

            moodButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    moodButtons.forEach((item) => item.classList.remove('is-active'));
                    button.classList.add('is-active');
                    applyMood(button.dataset.mood || 'cozy');
                });
            });

            findButton?.addEventListener('click', () => {
                const query = (input?.value || '').toLowerCase();
                const keyword = query.includes('laugh') || query.includes('fun') ? 'funny'
                    : query.includes('love') || query.includes('date') ? 'romantic'
                    : query.includes('scary') || query.includes('thrill') ? 'thrilling'
                    : query.includes('smart') || query.includes('mind') ? 'mind'
                    : 'cozy';

                const target = moodButtons.find((button) => button.dataset.mood === keyword);
                target?.click();
            });

            applyMood('cozy');
        })();
    </script>
}

@functions {
    private string Poster(MovieViewModel movie)
    {
        return string.IsNullOrWhiteSpace(movie?.PosterURL)
            ? Url.Content("~/img/poster/poster1.png")
            : movie.PosterURL;
    }

    private static string Safe(string value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string Clamp(string value, int maxLength)
    {
        var text = Safe(value, "A COSMOS pick selected for tonight's big-screen mood.");
        return text.Length <= maxLength ? text : text.Substring(0, maxLength).TrimEnd() + "...";
    }

    private static string DurationLabel(MovieViewModel movie)
    {
        return movie.Duration > 0 ? $"{movie.Duration} min" : "Runtime TBA";
    }

    private static bool IsUpcoming(MovieViewModel movie, DateTime today)
    {
        return movie.ReleaseDate.Date > today;
    }

    private static string HeroStatusLabel(MovieViewModel movie, DateTime today)
    {
        if (movie.ReleaseDate.Date > today)
        {
            return "Sắp chiếu tại COSMOS";
        }

        var hasTodayShowtime = movie.Showtimes?.Any(showtime => showtime.Date.Date == today) == true;
        if (hasTodayShowtime)
        {
            return "Đang chiếu hôm nay tại COSMOS";
        }

        var hasFutureShowtime = movie.Showtimes?.Any(showtime => showtime.Date.Date > today) == true;
        if (hasFutureShowtime)
        {
            return "Có lịch chiếu tại COSMOS";
        }

        return "Đang chiếu tại COSMOS";
    }

    private static string HeroStatusClass(MovieViewModel movie, DateTime today)
    {
        if (movie.ReleaseDate.Date > today)
        {
            return "movie-eyebrow--upcoming";
        }

        return movie.Showtimes?.Any(showtime => showtime.Date.Date == today) == true
            ? "movie-eyebrow--live"
            : string.Empty;
    }

    private static string HeroDateLabel(MovieViewModel movie, DateTime today)
    {
        if (movie.ReleaseDate.Date > today)
        {
            return $"Khởi chiếu {movie.ReleaseDate:dd/MM/yyyy}";
        }

        var nextShowtime = movie.Showtimes?
            .Where(showtime => showtime.Date.Date >= today)
            .OrderBy(showtime => showtime.Date)
            .ThenBy(showtime => showtime.StartTime)
            .FirstOrDefault();

        if (nextShowtime == null)
        {
            return movie.ReleaseDate == default
                ? "Lịch chiếu đang cập nhật"
                : $"Khởi chiếu {movie.ReleaseDate:dd/MM/yyyy}";
        }

        return nextShowtime.Date.Date == today
            ? $"Suất gần nhất {nextShowtime.StartTime:HH:mm}"
            : $"Suất tiếp theo {nextShowtime.Date:dd/MM/yyyy}";
    }

    private static string MovieMeta(MovieViewModel movie)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(movie.Genre))
        {
            parts.Add(movie.Genre);
        }

        if (movie.Duration > 0)
        {
            parts.Add($"{movie.Duration} min");
        }

        return parts.Any() ? string.Join(" / ", parts) : "Cinema pick";
    }

    private static string GenreData(MovieViewModel movie)
    {
        var raw = Safe(movie.Genre, string.Empty).ToLowerInvariant();
        var normalized = RemoveDiacritics(raw);
        var tokens = new List<string> { raw, normalized };

        if (normalized.Contains("hanh dong") || normalized.Contains("action"))
        {
            tokens.Add("action");
        }

        if (normalized.Contains("lang man") || normalized.Contains("romance"))
        {
            tokens.Add("romance");
        }

        if (normalized.Contains("khoa hoc") || normalized.Contains("vien tuong") || normalized.Contains("sci-fi") || normalized.Contains("science fiction"))
        {
            tokens.Add("sci-fi");
        }

        if (normalized.Contains("kinh di") || normalized.Contains("horror"))
        {
            tokens.Add("horror");
        }

        if (normalized.Contains("hoat hinh") || normalized.Contains("animation"))
        {
            tokens.Add("animation");
        }

        if (normalized.Contains("hai") || normalized.Contains("comedy"))
        {
            tokens.Add("comedy");
        }

        if (normalized.Contains("kich") || normalized.Contains("tam ly") || normalized.Contains("drama"))
        {
            tokens.Add("drama");
        }

        if (normalized.Contains("gia dinh") || normalized.Contains("family"))
        {
            tokens.Add("family");
        }

        return string.Join(" ", tokens.Where(token => !string.IsNullOrWhiteSpace(token)).Distinct());
    }

    private static string RemoveDiacritics(string text)
    {
        var normalized = text.Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder();

        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) != UnicodeCategory.NonSpacingMark)
            {
                builder.Append(character);
            }
        }

        return builder.ToString().Normalize(NormalizationForm.FormC).Replace('đ', 'd').Replace('Đ', 'D');
    }

    private static string ReviewScoreLabel(MovieViewModel movie)
    {
        return movie.ReviewCount > 0
            ? $"{movie.AverageRating.ToString("0.#", CultureInfo.InvariantCulture)} ({movie.ReviewCount})"
            : "Chưa có";
    }

    private static string ReviewAverageLabel(MovieViewModel movie)
    {
        return movie.ReviewCount > 0
            ? movie.AverageRating.ToString("0.#", CultureInfo.InvariantCulture)
            : "0.0";
    }

    private static string ReviewCountLabel(MovieViewModel movie)
    {
        return movie.ReviewCount > 0
            ? $"({movie.ReviewCount})"
            : "(0)";
    }

    private static string DateLabel(DateTime date)
    {
        return date == default
            ? "Coming soon"
            : date.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture);
    }

    private static string MatchReason(MovieViewModel movie)
    {
        var genres = GenreData(movie);

        if (genres.Contains("comedy") || genres.Contains("family") || genres.Contains("animation"))
        {
            return "Light, generous energy for an easy night out.";
        }

        if (genres.Contains("action") || genres.Contains("thriller") || genres.Contains("horror"))
        {
            return "High tension pacing with a big-screen pulse.";
        }

        if (genres.Contains("romance") || genres.Contains("drama"))
        {
            return "Character-led emotion with a slower afterglow.";
        }

        if (genres.Contains("sci-fi") || genres.Contains("mystery"))
        {
            return "A smart pick when you want the story to linger.";
        }

        return "Balanced tone, strong poster appeal, and a solid COSMOS score.";
    }
}
