@model BookingViewModel
@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = "Book Tickets | Cosmos Cinema";
    var showDates = Model.AvailableDates.Any()
        ? Model.AvailableDates
            .Select(value => DateTime.ParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture))
            .ToArray()
        : Enumerable.Range(1, 3).Select(offset => DateTime.Today.AddDays(offset)).ToArray();
    var showTimes = Model.AvailableTimes.Any() ? Model.AvailableTimes : new List<string> { Model.SelectedTime };
    var formats = Model.AvailableFormats.Any() ? Model.AvailableFormats : new List<string> { Model.CinemaFormat };
    var selectedSeats = Model.SelectedSeats.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var occupiedSeats = Model.OccupiedSeats.ToHashSet(StringComparer.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>
<body>
    <header class="site-header">
        <div class="shell header-row">
            <div class="brand"><span class="brand-mark" aria-hidden="true" type="button" herf=""></span> Cosmos Cinema</div>
            <div class="booking-header-actions">
                <div class="booking-timer" aria-live="polite">
                    <span class="status-dot"></span>
                    <strong id="bookingTimer">10:00</strong>
                </div>
                <button type="button" class="cancel-button" id="cancelBooking"><span aria-hidden="true">✕</span> Huỷ</button>
            </div>
        </div>
    </header>

    <div class="stepper-wrap">
        <nav class="shell stepper" aria-label="Booking progress">
            @for (var step = 1; step <= 4; step++)
            {
                var labels = new[] { "Thông tin phim", "Ghế ngồi", "Đồ ăn/uống", "Thanh toán" };
                <button type="button" class="stepper-button" data-step="@step" aria-label="Go to step @step, @labels[step - 1]">
                    <span class="step-number">@step</span><span class="step-label">@labels[step - 1]</span>
                </button>
            }
        </nav>
    </div>

    @Html.AntiForgeryToken()

    <main class="shell">
        <div id="step-1" class="booking-step" data-step="1">
            <p class="eyebrow">Step 1 of 4 · Choose a screening</p>
            <div class="detail-grid">
                <section class="card movie-hero" aria-labelledby="movieTitle">
                    <div class="movie-art" role="img" aria-label="@Model.MovieTitle poster">
                        @if (!string.IsNullOrWhiteSpace(Model.PosterURL))
                        {
                            <img src="@Model.PosterURL" alt="@Model.MovieTitle poster" />
                        }
                    </div>
                    <div class="movie-copy">
                        <h1 id="movieTitle">@Model.MovieTitle</h1>
                        <div class="rating" aria-label="Rated 4.8 out of 5">★★★★★ <small>4.8/5 · CRITIC CONSENSUS</small></div>
                        <dl class="facts">
                            <dt>Đạo diễn</dt><dd>@Model.Director</dd>
                            <dt>Diễn viên</dt><dd>@Model.Cast</dd>
                            <dt>Thời lượng</dt><dd>@Model.DurationMinutes min@(string.IsNullOrWhiteSpace(Model.Genre) ? "" : $" · {Model.Genre}")</dd>
                            <dt>Độ tuổi</dt><dd>@Model.AgeRating</dd>
                        </dl>
                        <p class="synopsis">@Model.Synopsis</p>
                    </div>
                </section>

                <aside class="card schedule-card" aria-labelledby="scheduleTitle">
                    <h3 id="scheduleTitle">Đặt Lịch Chiếu</h3>
                    <span class="field-label">Chọn ngày</span>
                    <div class="date-options" role="group" aria-label="Show date">
                        @foreach (var date in showDates)
                        {
                            var value = date.ToString("yyyy-MM-dd");
                            <button type="button" class="choice date-choice @(Model.SelectedDate == value ? "selected" : "")" data-date="@value">
                                @date.ToString("ddd", CultureInfo.InvariantCulture)<span>@date.ToString("MMM dd", CultureInfo.InvariantCulture)</span>
                            </button>
                        }
                    </div>
                    <label class="field-label" for="cinemaFormat">ĐỊNH DẠNG RẠP CHIẾU</label>
                    <select id="cinemaFormat" class="dark-select">
                        @foreach (var format in formats)
                        {
                            <option selected="@(Model.CinemaFormat == format)">@format</option>
                        }
                    </select>
                    <span class="field-label">Thời gian chiếu</span>
                    <div class="time-options" role="group" aria-label="Show time">
                        @foreach (var time in showTimes)
                        {
                            <button type="button" class="choice time-choice @(Model.SelectedTime == time ? "selected" : "")" data-time="@time">@time</button>
                        }
                    </div>
                    <button type="button" id="selectSeatsButton" class="primary-button full">
                        <i class="fa-solid fa-ticket"></i>
                        <span style="font-family: 'Archivo Narrow', sans-serif">Chọn Ghế →</span>
                    </button>
                </aside>
            </div>
        </div>

        <div id="step-2" class="booking-step" data-step="2">
            <header class="step-heading">
                <div>
                    <p class="eyebrow">Step 2 of 4 · Select seats</p>
                    <h2>@Model.MovieTitle</h2>
                    <div class="movie-meta">
                        <span class="meta-pill" id="metaDate">▣ @Model.SelectedDate</span>
                        <span class="meta-pill" id="metaTime">◷ @Model.SelectedTime</span>
                        <span class="meta-pill" id="metaFormat">⌖ @Model.CinemaFormat</span>
                    </div>
                </div>
            </header>
            <div class="content-summary-grid">
                <section class="card seat-card" aria-label="Seat map">
                    <div class="screen-wrap"><div class="screen"></div><div class="screen-label">MÀN HÌNH CHIẾU</div></div>
                    <div class="seat-matrix">
                        @for (var rowChar = 'A'; rowChar <= 'G'; rowChar++)
                        {
                            <div class="seat-row" data-row="@rowChar"><span class="row-label">@rowChar</span>
                                @for (var number = 1; number <= 10; number++)
                                {
                                    var seatId = $"{rowChar}{number}";
                                    var occupied = occupiedSeats.Contains(seatId);
                                    <button type="button" data-seat="@seatId" disabled="@occupied"
                                            aria-label="Seat @seatId @(occupied ? "occupied" : "available")"
                                            aria-pressed="@(selectedSeats.Contains(seatId) ? "true" : "false")"
                                            class="seat @(occupied ? "occupied" : "") @(selectedSeats.Contains(seatId) ? "selected" : "") @((number == 3 || number == 7) ? "aisle-after" : "")">@seatId</button>
                                }
                            </div>
                        }
                        <div class="seat-row sweetbox-row" data-row="H"><span class="row-label">H</span>
                            @for (var number = 1; number <= 5; number++)
                            {
                                var seatId = $"H{number}";
                                <button type="button" data-seat="@seatId" aria-label="Sweetbox seat @seatId"
                                        aria-pressed="@(selectedSeats.Contains(seatId) ? "true" : "false")"
                                        class="seat sweetbox @(selectedSeats.Contains(seatId) ? "selected" : "")">@seatId</button>
                            }
                        </div>
                    </div>
                    <div class="legend"><span><i></i>Available</span><span><i class="selected-key"></i>Selected</span><span><i class="sweet-key"></i>Sweetbox</span></div>
                </section>
                <aside class="card summary-card">
                    <h3 class="summary-title">Đặt Ghế</h3>
                    <span class="summary-label">Ghế đã chọn</span>
                    <div class="selected-list" id="selectedSeatList"></div>
                    <div class="totals">
                        <div class="total-line"><span id="ticketCount">Số lượng ghế (0)</span><span id="ticketSubtotal">$0.00</span></div>
                        <div class="total-line"><span>Phí dịch vụ</span><span id="seatFee">$0.00</span></div>
                        <div class="total-line grand"><span>Tổng</span><span id="seatTotal">$0.00</span></div>
                    </div>
                    <div class="summary-actions">
                        <button type="button" id="confirmSeats" class="primary-button full">Xác nhận đặt ghế →</button>
                        <button type="button" class="secondary-button full back-button" data-target="1">← Thay đổi định dạng rạp</button>
                    </div>
                    <p class="secure-note">▱ Giao dịch được bảo mật</p>
                </aside>
            </div>
        </div>

        <div id="step-3" class="booking-step" data-step="3">
            <header class="step-heading"><div><p class="eyebrow">Step 3 of 4 · Add-ons</p><h2>Enhance Your Experience</h2><p class="subtitle">Pre-order your cinema favorites now and skip the queue. Freshly prepared and waiting for you.</p></div></header>
            <div class="content-summary-grid">
                <section class="concession-grid" aria-label="Concessions">
                    @foreach (var item in Model.Concessions)
                    {
                        <article class="card product-card" data-product="@item.Id">
                            <div class="product-art" aria-hidden="true">@item.Icon</div>
                            <div class="product-body">
                                <h3>@item.Name</h3><p class="product-description">@item.Description</p>
                                <div class="product-footer"><span class="price">@item.Price.ToString("C", CultureInfo.GetCultureInfo("en-US"))</span>
                                    <div class="quantity" aria-label="Quantity for @item.Name">
                                        <button type="button" class="quantity-change" data-delta="-1" aria-label="Remove one">−</button>
                                        <span class="quantity-value" data-quantity="@item.Id">@item.Quantity</span>
                                        <button type="button" class="quantity-change plus" data-delta="1" aria-label="Add one">+</button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </section>
                <aside class="card summary-card">
                    <h3>Booking Summary</h3><span class="summary-label">@Model.MovieTitle</span>
                    <div class="compact-list" id="addonSummary"></div>
                    <div class="totals"><div class="total-line"><span>Tickets & fees</span><span id="addonTicketsTotal">$0.00</span></div><div class="total-line"><span>Concessions</span><span id="addonTotal">$0.00</span></div><div class="total-line grand"><span>Total</span><span id="step3Total">$0.00</span></div></div>
                    <div class="summary-actions"><button type="button" id="proceedCheckout" class="primary-button full">Proceed to payment →</button><button type="button" id="skipAddons" class="secondary-button full">Skip add-ons</button><button type="button" class="secondary-button full back-button" data-target="2">← Edit seats</button></div>
                </aside>
            </div>
        </div>

        <div id="step-4" class="booking-step" data-step="4">
            <header class="step-heading"><div><p class="eyebrow">Step 4 of 4 · Checkout</p><h2>Secure Checkout</h2><p class="subtitle">
                Xem lại các lựa chọn của bạn và hoàn tất thanh toán một cách an toàn.</p></div></header>
            <div class="checkout-grid">
                <section class="checkout-stack">
                    <article class="card checkout-card"><h3>🎟 Admission</h3><div class="checkout-row"><div><span id="checkoutTicketLabel">Tickets</span><div class="checkout-detail" id="checkoutSeats"></div><div class="checkout-detail" id="checkoutScreening"></div></div><strong id="checkoutTicketTotal">$0.00</strong></div></article>
                    <article class="card checkout-card"><h3>🍿 Concessions</h3><div id="checkoutConcessions"></div></article>
                    <p class="secure-note">▣ Các khoản thanh toán được xử lý bằng phương thức mã hóa an toàn..</p>
                </section>
                <aside class="card payment-card">
                    <h3>Payment Summary</h3>
                    <div class="totals"><div class="total-line"><span>Subtotal</span><span id="checkoutSubtotal">$0.00</span></div><div class="total-line"><span>Booking fee</span><span id="checkoutFee">$0.00</span></div><div class="total-line"><span>Tax (8%)</span><span id="checkoutTax">$0.00</span></div></div>
                    <div class="promo"><input type="text" placeholder="◇ ENTER PROMO CODE" aria-label="Promo code" /><button type="button" id="applyPromo">Apply</button></div>
                    <div class="payment-due"><div class="total-line grand"><span>Total due</span><span><b id="grandTotal">$0.00</b><small class="currency">USD</small></span></div></div>
                    <button type="button" id="confirmPayment" class="primary-button full">Confirm payment →</button>
                    <button type="button" class="secondary-button full back-button" data-target="3" style="margin-top:9px">← Edit add-ons</button>
                    <p class="secure-note">Bằng cách tiếp tục, bạn sẽ đồng ý với Điều khoản Dịch vụ của chúng tôi.</p>
                </aside>
            </div>
        </div>
    </main>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <div class="confirmation" id="confirmation" role="dialog" aria-modal="true" aria-labelledby="confirmationTitle">
        <div class="card confirmation-card"><div class="checkmark">✓</div><p class="eyebrow">Booking complete</p><h2 id="confirmationTitle">Enjoy the show!</h2><p class="subtitle">Your payment was confirmed and your seats are reserved.</p><p class="confirmation-code" id="confirmationCode"></p></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (() => {
            "use strict";

            const endpoints = {
                schedule: '@Url.Action("SaveSchedule", "Home")',
                seat: '@Url.Action("ToggleSeat", "Home")',
                concession: '@Url.Action("UpdateConcession", "Home")',
                step: '@Url.Action("SetStep", "Home")',
                payment: '@Url.Action("ConfirmPayment", "Home")',
                cancel: '@Url.Action("Cancel", "Home")',
                home: '@Url.Action("Index", "Home")'
            };
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            let state = @Html.Raw(Json.Serialize(new
            {
                currentStep = Model.CurrentStep,
                bookingExpiresAtUtc = Model.BookingExpiresAtUtc,
                selectedDate = Model.SelectedDate,
                selectedTime = Model.SelectedTime,
                cinemaFormat = Model.CinemaFormat,
                showtimeChoices = Model.ShowtimeChoices.Select(item => new { item.ShowtimeId, item.Date, item.Time, item.Format }),
                selectedSeats = Model.SelectedSeats,
                standardTicketPrice = Model.StandardTicketPrice,
                sweetboxTicketPrice = Model.SweetboxTicketPrice,
                ticketSubtotal = Model.TicketSubtotal,
                convenienceFee = Model.ConvenienceFee,
                concessions = Model.Concessions.Select(item => new { item.Id, item.Name, item.Price, item.Quantity, lineTotal = item.Price * item.Quantity }),
                concessionSubtotal = Model.ConcessionSubtotal,
                preTaxTotal = Model.PreTaxTotal,
                tax = Model.Tax,
                grandTotal = Model.GrandTotal
            }));

            function ajaxPost(url, payload = {}) {
                return $.ajax({
                    url,
                    method: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(payload),
                    headers: { 'RequestVerificationToken': token }
                });
            }

            function money(value) { return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(Number(value || 0)); }
            function messageFrom(xhr) { return xhr.responseJSON?.message || 'Something went wrong. Please try again.'; }
            function redirectHome(url) { window.location.href = url || endpoints.home; }
            function handleAjaxFail(xhr) {
                if (xhr.status === 440 && xhr.responseJSON?.redirectUrl) {
                    toast(messageFrom(xhr));
                    setTimeout(() => redirectHome(xhr.responseJSON.redirectUrl), 900);
                    return;
                }

                toast(messageFrom(xhr));
            }
            let toastTimer;
            function toast(message, success = false) {
                const element = document.getElementById('toast');
                element.textContent = message;
                element.classList.toggle('success', success);
                element.classList.add('show');
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => element.classList.remove('show'), 3500);
            }

            function showStep(step) {
                document.querySelectorAll('.booking-step').forEach(panel => panel.classList.toggle('active', Number(panel.dataset.step) === step));
                document.querySelectorAll('.stepper-button').forEach(button => {
                    const number = Number(button.dataset.step);
                    button.classList.toggle('active', number === step);
                    button.classList.toggle('complete', number < step);
                    button.setAttribute('aria-current', number === step ? 'step' : 'false');
                });
                state.currentStep = step;
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            let countdownTimer;
            function startCountdown() {
                const timer = document.getElementById('bookingTimer');
                const expiresAt = new Date(state.bookingExpiresAtUtc).getTime();

                function tick() {
                    const remaining = Math.max(0, expiresAt - Date.now());
                    const totalSeconds = Math.ceil(remaining / 1000);
                    const isLastMinute = totalSeconds <= 60;
                    const minutes = String(Math.floor(totalSeconds / 60)).padStart(2, '0');
                    const seconds = String(totalSeconds % 60).padStart(2, '0');
                    const timerWrap = timer.closest('.booking-timer');

                    timer.textContent = `${minutes}:${seconds}`;
                    timer.classList.toggle('danger', isLastMinute);
                    timerWrap?.classList.toggle('is-danger', isLastMinute);

                    if (remaining <= 0) {
                        clearInterval(countdownTimer);
                        toast('Phiên đặt vé đã hết hạn. Vui lòng chọn lại phim.');
                        ajaxPost(endpoints.cancel)
                            .always(() => setTimeout(() => redirectHome(), 1100));
                    }
                }

                tick();
                countdownTimer = setInterval(tick, 1000);
            }

            function changeStep(step) {
                ajaxPost(endpoints.step, { step }).done(snapshot => {
                    state = { ...state, ...snapshot };
                    render();
                    showStep(step);
                }).fail(handleAjaxFail);
            }

            function render() {
                const seats = state.selectedSeats || [];
                document.querySelectorAll('.seat[data-seat]:not(.occupied)').forEach(button => {
                    const selected = seats.includes(button.dataset.seat);
                    button.classList.toggle('selected', selected);
                    button.setAttribute('aria-pressed', selected ? 'true' : 'false');
                });

                const list = document.getElementById('selectedSeatList');
                list.innerHTML = seats.length
                    ? seats.map(seat => `<div class="selected-line"><span>${seat.startsWith('H') ? 'Sweetbox' : 'Seat'} ${seat}</span><span>${money(seat.startsWith('H') ? state.sweetboxTicketPrice : state.standardTicketPrice)}</span></div>`).join('')
                    : '<div class="empty-state">Select seats from the map</div>';
                document.getElementById('ticketCount').textContent = `Tickets (${seats.length})`;
                document.getElementById('ticketSubtotal').textContent = money(state.ticketSubtotal);
                document.getElementById('seatFee').textContent = money(state.convenienceFee);
                document.getElementById('seatTotal').textContent = money(Number(state.ticketSubtotal) + Number(state.convenienceFee));
                document.getElementById('confirmSeats').disabled = seats.length === 0;

                document.getElementById('metaDate').textContent = `▣ ${state.selectedDate}`;
                document.getElementById('metaTime').textContent = `◷ ${state.selectedTime}`;
                document.getElementById('metaFormat').textContent = `⌖ ${state.cinemaFormat}`;

                (state.concessions || []).forEach(item => {
                    const quantity = document.querySelector(`[data-quantity="${item.id}"]`);
                    if (quantity) quantity.textContent = item.quantity;
                });
                const selectedAddons = (state.concessions || []).filter(item => item.quantity > 0);
                document.getElementById('addonSummary').innerHTML =
                    `<div class="compact-line"><span>Tickets<small>Seats: ${seats.join(', ') || 'None'}</small></span><span>${money(Number(state.ticketSubtotal) + Number(state.convenienceFee))}</span></div>` +
                    (selectedAddons.length ? selectedAddons.map(item => `<div class="compact-line"><span>${item.quantity}× ${item.name}</span><span>${money(item.lineTotal)}</span></div>`).join('') : '<div class="empty-state">No concessions added</div>');
                document.getElementById('addonTicketsTotal').textContent = money(Number(state.ticketSubtotal) + Number(state.convenienceFee));
                document.getElementById('addonTotal').textContent = money(state.concessionSubtotal);
                document.getElementById('step3Total').textContent = money(state.preTaxTotal);

                document.getElementById('checkoutTicketLabel').textContent = `${seats.length}× Admission`;
                document.getElementById('checkoutSeats').textContent = `Seats: ${seats.join(', ')}`;
                document.getElementById('checkoutScreening').textContent = `${state.selectedDate} · ${state.selectedTime} · ${state.cinemaFormat}`;
                document.getElementById('checkoutTicketTotal').textContent = money(state.ticketSubtotal);
                document.getElementById('checkoutConcessions').innerHTML = selectedAddons.length
                    ? selectedAddons.map(item => `<div class="checkout-row"><span>${item.quantity}× ${item.name}</span><strong>${money(item.lineTotal)}</strong></div>`).join('')
                    : '<div class="empty-state">No concessions selected</div>';
                document.getElementById('checkoutSubtotal').textContent = money(Number(state.ticketSubtotal) + Number(state.concessionSubtotal));
                document.getElementById('checkoutFee').textContent = money(state.convenienceFee);
                document.getElementById('checkoutTax').textContent = money(state.tax);
                document.getElementById('grandTotal').textContent = money(state.grandTotal);
            }

            function getSelectedDate() {
                return document.querySelector('.date-choice.selected')?.dataset.date || state.selectedDate;
            }

            function getSelectedFormat() {
                return document.getElementById('cinemaFormat').value || state.cinemaFormat;
            }

            function renderTimeChoices() {
                const selectedDate = getSelectedDate();
                const selectedFormat = getSelectedFormat();
                const container = document.querySelector('.time-options');
                const choices = (state.showtimeChoices || [])
                    .filter(item => item.date === selectedDate && item.format === selectedFormat);

                container.innerHTML = choices.length
                    ? choices.map((item, index) => {
                        const selected = item.time === state.selectedTime || index === 0;
                        return `<button type="button" class="choice time-choice ${selected ? 'selected' : ''}" data-time="${item.time}" data-showtime-id="${item.showtimeId}">${item.time}</button>`;
                    }).join('')
                    : '<div class="empty-state">Không có suất chiếu phù hợp</div>';

                bindTimeChoices();
            }

            function bindTimeChoices() {
                document.querySelectorAll('.time-choice').forEach(button => button.addEventListener('click', () => {
                    document.querySelectorAll('.time-choice').forEach(item => item.classList.remove('selected'));
                    button.classList.add('selected');
                }));
            }

            document.querySelectorAll('.date-choice').forEach(button => button.addEventListener('click', () => {
                document.querySelectorAll('.date-choice').forEach(item => item.classList.remove('selected'));
                button.classList.add('selected');
                renderTimeChoices();
            }));
            document.getElementById('cinemaFormat').addEventListener('change', renderTimeChoices);
            bindTimeChoices();

            document.getElementById('selectSeatsButton').addEventListener('click', event => {
                const button = event.currentTarget;
                button.disabled = true;
                ajaxPost(endpoints.schedule, {
                    date: document.querySelector('.date-choice.selected')?.dataset.date,
                    time: document.querySelector('.time-choice.selected')?.dataset.time,
                    format: document.getElementById('cinemaFormat').value
                }).done(snapshot => {
                    state = { ...state, ...snapshot };
                    render();
                    showStep(2);
                }).fail(handleAjaxFail).always(() => button.disabled = false);
            });

            document.querySelectorAll('.seat[data-seat]:not(.occupied)').forEach(button => button.addEventListener('click', () => {
                button.disabled = true;
                ajaxPost(endpoints.seat, { seatId: button.dataset.seat }).done(snapshot => {
                    state = { ...state, ...snapshot };
                    render();
                }).fail(handleAjaxFail).always(() => button.disabled = false);
            }));

            document.querySelectorAll('.quantity-change').forEach(button => button.addEventListener('click', () => {
                const card = button.closest('[data-product]');
                const item = state.concessions.find(value => value.id === card.dataset.product);
                const quantity = Math.max(0, Math.min(10, Number(item.quantity) + Number(button.dataset.delta)));
                if (quantity === item.quantity) return;
                card.querySelectorAll('button').forEach(itemButton => itemButton.disabled = true);
                ajaxPost(endpoints.concession, { productId: item.id, quantity }).done(snapshot => {
                    state = { ...state, ...snapshot };
                    render();
                }).fail(handleAjaxFail).always(() => card.querySelectorAll('button').forEach(itemButton => itemButton.disabled = false));
            }));

            document.querySelectorAll('.stepper-button').forEach(button => button.addEventListener('click', () => changeStep(Number(button.dataset.step))));
            document.querySelectorAll('.back-button').forEach(button => button.addEventListener('click', () => changeStep(Number(button.dataset.target))));
            document.getElementById('confirmSeats').addEventListener('click', () => changeStep(3));
            document.getElementById('proceedCheckout').addEventListener('click', () => changeStep(4));
            document.getElementById('skipAddons').addEventListener('click', () => changeStep(4));

            document.getElementById('applyPromo').addEventListener('click', () => toast('That promo code is not available for this screening.'));
            document.getElementById('confirmPayment').addEventListener('click', event => {
                const button = event.currentTarget;
                button.disabled = true;
                button.textContent = 'Processing…';
                ajaxPost(endpoints.payment).done(result => {
                    document.getElementById('confirmationCode').textContent = result.confirmationNumber;
                    document.getElementById('confirmation').classList.add('show');
                }).fail(handleAjaxFail).always(() => {
                    button.disabled = false;
                    button.textContent = 'Confirm payment →';
                });
            });

            document.getElementById('cancelBooking').addEventListener('click', () => {
                if (!window.confirm('Cancel this booking and clear all selections?')) return;
                ajaxPost(endpoints.cancel)
                    .done(result => redirectHome(result.redirectUrl))
                    .fail(handleAjaxFail);
            });

            render();
            renderTimeChoices();
            startCountdown();
            showStep(Math.min(4, Math.max(1, Number(state.currentStep) || 1)));
        })();
    </script>
</body>
</html>
