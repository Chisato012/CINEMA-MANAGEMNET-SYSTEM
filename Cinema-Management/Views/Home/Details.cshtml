@model Cinema_Management.Models.MovieViewModel
@using System.Globalization

@{
    ViewData["Title"] = Model.Title + " - Movie Details";
    var firstFutureShowtime = Model.Showtimes?
        .Where(s => s.Date.Date >= DateTime.Today)
        .OrderBy(s => s.Date)
        .ThenBy(s => s.StartTime)
        .FirstOrDefault();
    var reviewSummary = Model.ReviewSummary ?? new MovieReviewSummaryViewModel();
    var reviews = Model.Reviews ?? new List<MovieReviewViewModel>();
    var isSignedIn = ViewBag.CanReview is bool canReview && canReview;
}

@section Styles {
    <link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />
}

<main class="details-page">
    <nav class="details-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.47 5.47a.75.75 0 0 1 1.06 0l6 6a.75.75 0 0 1 0 1.06l-6 6a.75.75 0 1 1-1.06-1.06L14.94 12 9.47 6.53a.75.75 0 0 1 0-1.06Z" />
        </svg>
        <span class="breadcrumb-current">@Model.Title</span>
    </nav>

    <section class="details-hero" style="--poster-image: url('@Model.PosterURL');">
        <div class="details-hero__content">
            <div class="details-poster" aria-label="Poster phim @Model.Title">
                <div class="details-poster__frame">
                    <img src="@Model.PosterURL" alt="Poster phim @Model.Title" />
                </div>
            </div>

            <div class="details-info">
                <p class="details-kicker">COSMOS giới thiệu</p>

                <div class="details-tags" aria-label="Thông tin nhanh">
                    @if (!string.IsNullOrEmpty(Model.Genre))
                    {
                        <span class="details-tag">@Model.Genre</span>
                    }
                    <span class="details-tag details-tag--duration">@Model.Duration phút</span>
                    @if (!string.IsNullOrEmpty(Model.AgeRating))
                    {
                        <span class="details-tag details-tag--age">@Model.AgeRating</span>
                    }
                </div>

                <h1 class="details-title">@Model.Title</h1>

                @if (!string.IsNullOrEmpty(Model.Synopsis))
                {
                    <p class="details-synopsis">@Model.Synopsis</p>
                }

                <div class="details-actions">
                    <a class="details-btn--book" asp-controller="Booking" asp-action="SelectShowtime" asp-route-movieId="@Model.MovieId">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5.75 5A2.75 2.75 0 0 0 3 7.75v2.5a.75.75 0 0 0 .75.75 1 1 0 0 1 0 2 .75.75 0 0 0-.75.75v2.5A2.75 2.75 0 0 0 5.75 20h12.5A2.75 2.75 0 0 0 21 17.25v-2.5a.75.75 0 0 0-.75-.75 1 1 0 0 1 0-2 .75.75 0 0 0 .75-.75v-2.5A2.75 2.75 0 0 0 18.25 5H5.75Zm0 1.5h12.5c.69 0 1.25.56 1.25 1.25v1.85a2.5 2.5 0 0 0 0 4.8v1.85c0 .69-.56 1.25-1.25 1.25H5.75c-.69 0-1.25-.56-1.25-1.25V14.4a2.5 2.5 0 0 0 0-4.8V7.75c0-.69.56-1.25 1.25-1.25Zm8 2.25a.75.75 0 0 1 .75.75v5a.75.75 0 0 1-1.5 0v-5a.75.75 0 0 1 .75-.75Z" />
                        </svg>
                        <span>Đặt vé</span>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(Model.Trailer))
                    {
                        <button type="button"
                                class="details-btn--trailer"
                                id="btn-watch-trailer"
                                onclick="openTrailer('@Model.Trailer')">
                            <span class="play-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M8.75 5.74c0-.93 1.02-1.5 1.82-1.02l9.03 5.43a1.2 1.2 0 0 1 0 2.06l-9.03 5.43a1.2 1.2 0 0 1-1.82-1.02V5.74Z" />
                                </svg>
                            </span>
                            <span>Xem trailer</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="details-extra" aria-labelledby="movie-facts-title">
        <div class="details-section-heading">
            <p>Hồ sơ phim</p>
            <h2 id="movie-facts-title">Thông tin chi tiết</h2>
        </div>

        <div class="details-extra__grid">
            @if (!string.IsNullOrEmpty(Model.MovieDirector))
            {
                <div class="details-extra__item">
                    <span class="details-extra__label">Đạo diễn</span>
                    <span class="details-extra__value">@Model.MovieDirector</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.MovieCast))
            {
                <div class="details-extra__item">
                    <span class="details-extra__label">Diễn viên</span>
                    <span class="details-extra__value">@Model.MovieCast</span>
                </div>
            }

            @if (Model.Language != null)
            {
                <div class="details-extra__item">
                    <span class="details-extra__label">Ngôn ngữ</span>
                    <span class="details-extra__value">@Model.Language.LanguageName</span>
                </div>
            }

            @if (Model.Country != null)
            {
                <div class="details-extra__item">
                    <span class="details-extra__label">Quốc gia</span>
                    <span class="details-extra__value">@Model.Country.CountryName</span>
                </div>
            }

            <div class="details-extra__item">
                <span class="details-extra__label">Ngày khởi chiếu</span>
                <span class="details-extra__value">@Model.ReleaseDate.ToString("dd/MM/yyyy")</span>
            </div>

            <div class="details-extra__item">
                <span class="details-extra__label">Thời lượng</span>
                <span class="details-extra__value">@Model.Duration phút</span>
            </div>
        </div>
    </section>

    <section class="reviews-section" aria-labelledby="movie-reviews-title">
        <div class="details-section-heading">
            <p>Ý kiến khán giả</p>
            <h2 id="movie-reviews-title">Đánh giá</h2>
        </div>

        <div class="reviews-layout">
            <aside class="reviews-summary" aria-label="Tổng quan đánh giá">
                <span class="reviews-summary__label">Điểm trung bình</span>
                <div class="reviews-summary__score">
                    <strong>@FormatRating(reviewSummary.AverageRating)</strong>
                    <span>/ 5</span>
                </div>
                <div class="review-stars" style="--rating-percent: @RatingPercent(reviewSummary.AverageRating);" aria-label="@FormatRating(reviewSummary.AverageRating) trên 5">
                    <span class="review-stars__base" aria-hidden="true">★★★★★</span>
                    <span class="review-stars__fill" aria-hidden="true">★★★★★</span>
                </div>
                <p>@reviewSummary.TotalRatings lượt đánh giá</p>
            </aside>

            <div class="reviews-panel">
                @if (isSignedIn)
                {
                    <form class="review-form" asp-controller="Home" asp-action="AddReview" method="post" data-review-form novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MovieId" value="@Model.MovieId" />
                        <input type="hidden" name="Rating" id="ReviewRating" data-review-rating />

                        <div class="review-form__header">
                            <div>
                                <span class="review-form__eyebrow">Đánh giá của bạn</span>
                                <h3>Chia sẻ cảm nhận về @Model.Title</h3>
                            </div>
                            <span class="review-form__value" data-review-rating-label>0.00 / 5</span>
                        </div>

                        <div class="review-form__picker" role="radiogroup" aria-label="Chọn điểm đánh giá">
                            @for (var rating = 1; rating <= 5; rating++)
                            {
                                <button type="button" class="review-star-button" data-review-star data-rating-value="@rating" aria-label="@rating trên 5">
                                    ★
                                </button>
                            }
                        </div>

                        <input class="review-rating-range"
                               type="range"
                               min="0"
                               max="5"
                               step="0.25"
                               value="0"
                               data-review-rating-range
                               aria-label="Điểm đánh giá chi tiết" />

                        <label class="review-form__comment" for="ReviewComment">
                            <span>Bình luận</span>
                            <textarea id="ReviewComment"
                                      name="Comment"
                                      rows="5"
                                      maxlength="2000"
                                      data-review-comment
                                      required></textarea>
                        </label>

                        <p class="review-form__error" data-review-error role="alert"></p>

                        <button class="review-submit" type="submit" data-review-submit>
                            <span data-review-submit-text>Gửi đánh giá</span>
                        </button>
                    </form>
                }
                else
                {
                    <div class="review-login">
                        <div>
                            <span class="review-form__eyebrow">Đánh giá của bạn</span>
                            <h3>Đăng nhập để gửi đánh giá</h3>
                        </div>
                        <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    </div>
                }

                <div class="review-list" aria-label="Danh sách đánh giá">
                    @if (reviews.Any())
                    {
                        @foreach (var review in reviews)
                        {
                            <article class="review-card">
                                <div class="review-card__avatar" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(review.UserAvatarUrl))
                                    {
                                        <img src="@review.UserAvatarUrl" alt="" />
                                    }
                                    else
                                    {
                                        <span>@ReviewInitial(review.UserFullName)</span>
                                    }
                                </div>

                                <div class="review-card__body">
                                    <div class="review-card__topline">
                                        <div>
                                            <h3>@review.UserFullName</h3>
                                            <time datetime="@review.CreatedAt.ToString("O", CultureInfo.InvariantCulture)">
                                                @review.CreatedAt.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)
                                            </time>
                                        </div>
                                        <div class="review-card__rating">
                                            <div class="review-stars review-stars--small" style="--rating-percent: @RatingPercent(review.Rating);" aria-label="@FormatRating(review.Rating) trên 5">
                                                <span class="review-stars__base" aria-hidden="true">★★★★★</span>
                                                <span class="review-stars__fill" aria-hidden="true">★★★★★</span>
                                            </div>
                                            <strong>@FormatRating(review.Rating)</strong>
                                        </div>
                                    </div>

                                    <p>@review.Comment</p>
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="reviews-empty">
                            <h3>Chưa có đánh giá nào</h3>
                            <p>Những đánh giá mới nhất sẽ xuất hiện tại đây sau khi khán giả gửi cảm nhận.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    @{
        var today = DateTime.Today;
        var endDate = today.AddDays(6);
        var displayDates = Enumerable.Range(0, 7)
            .Select(offset => today.AddDays(offset))
            .ToList();

        var showtimesByDate = (Model.Showtimes ?? Enumerable.Empty<Cinema_Management.Models.Showtimes>())
            .Where(s => s.Date.Date >= today && s.Date.Date <= endDate)
            .OrderBy(s => s.Date)
            .GroupBy(s => s.Date.Date)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(s => s.StartTime).ToList());

        var vietnameseDays = new Dictionary<DayOfWeek, string>
        {
            { DayOfWeek.Monday, "T2" },
            { DayOfWeek.Tuesday, "T3" },
            { DayOfWeek.Wednesday, "T4" },
            { DayOfWeek.Thursday, "T5" },
            { DayOfWeek.Friday, "T6" },
            { DayOfWeek.Saturday, "T7" },
            { DayOfWeek.Sunday, "CN" }
        };
    }

    <section class="showtimes-section" aria-labelledby="showtimes-title">
        <div class="showtimes-header">
            <p>Lịch trong 7 ngày tới</p>
            <h2 class="showtimes-header__title" id="showtimes-title">Lịch chiếu</h2>
        </div>
        @*  *@
        <div class="showtimes-dates" role="tablist" aria-label="Chọn ngày chiếu">
            @for (int i = 0; i < displayDates.Count; i++)
            {
                var date = displayDates[i];
                var dayLabel = vietnameseDays[date.DayOfWeek];
                var isActive = i == 0 ? "active" : "";

                <button class="showtimes-date-tab @isActive"
                        type="button"
                        data-date="@date.ToString("yyyy-MM-dd")"
                        onclick="switchDateTab(this)">
                    <span class="showtimes-date-tab__day">@date.Day</span>
                    <span class="showtimes-date-tab__month">/@date.ToString("MM") - @dayLabel</span>
                </button>
            }
        </div>

        @for (int i = 0; i < displayDates.Count; i++)
        {
            var date = displayDates[i];
            var displayStyle = i == 0 ? "flex" : "none";
            var hasShowtimes = showtimesByDate.TryGetValue(date, out var dateShowtimes) && dateShowtimes.Any();

            <div class="showtimes-times" data-date="@date.ToString("yyyy-MM-dd")" style="display: @displayStyle;">
                @if (hasShowtimes)
                {
                    <div class="showtimes-times__grid">
                        @foreach (var showtime in dateShowtimes!)
                        {
                            <a class="showtimes-time-card"
                               asp-controller="Booking"
                               asp-action="SelectShowtime"
                               asp-route-movieId="@Model.MovieId">
                                <span class="showtimes-time-card__time">@showtime.StartTime.ToString("HH:mm")</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="showtimes-empty showtimes-empty--panel">
                        <p>Chưa có suất chiếu trong ngày này.</p>
                    </div>
                }
            </div>
        }
    </section>

    <div class="trailer-modal" id="trailerModal" aria-hidden="true">
        <div class="trailer-modal__content">
            <button class="trailer-modal__close" onclick="closeTrailer()" aria-label="Đóng trailer">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6.22 4.97a.75.75 0 0 1 1.06 0L12 9.69l4.72-4.72a.75.75 0 1 1 1.06 1.06L13.06 10.75l4.72 4.72a.75.75 0 1 1-1.06 1.06L12 11.81l-4.72 4.72a.75.75 0 0 1-1.06-1.06l4.72-4.72-4.72-4.72a.75.75 0 0 1 0-1.06Z" />
                </svg>
            </button>
            <iframe id="trailerIframe"
                    src=""
                    allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
            </iframe>
        </div>
    </div>
</main>

@functions {
    private static string FormatRating(decimal rating)
    {
        return rating.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string RatingPercent(decimal rating)
    {
        var clamped = Math.Min(5m, Math.Max(0m, rating));
        return (clamped / 5m * 100m).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private static string ReviewInitial(string fullName)
    {
        return string.IsNullOrWhiteSpace(fullName)
            ? "C"
            : fullName.Trim()[0].ToString().ToUpperInvariant();
    }
}

@section Scripts {
    <script>
        // Convert YouTube URL to embed URL
        function getEmbedUrl(url) {
            if (!url) return '';
            // Handle youtu.be short links
            let match = url.match(/youtu\.be\/([a-zA-Z0-9_-]+)/);
            if (match) return 'https://www.youtube.com/embed/' + match[1] + '?autoplay=1';
            // Handle youtube.com/watch?v= links
            match = url.match(/[?&]v=([a-zA-Z0-9_-]+)/);
            if (match) return 'https://www.youtube.com/embed/' + match[1] + '?autoplay=1';
            return url;
        }

        function openTrailer(trailerUrl) {
            if (!trailerUrl) {
                alert('Trailer chưa có sẵn.');
                return;
            }
            const modal = document.getElementById('trailerModal');
            const iframe = document.getElementById('trailerIframe');
            iframe.src = getEmbedUrl(trailerUrl);
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeTrailer() {
            const modal = document.getElementById('trailerModal');
            const iframe = document.getElementById('trailerIframe');
            iframe.src = '';
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        // Close modal on ESC key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeTrailer();
        });

        // Close modal on backdrop click
        document.getElementById('trailerModal').addEventListener('click', function (e) {
            if (e.target === this) closeTrailer();
        });

        // Showtimes date tab switching
        function switchDateTab(clickedTab) {
            // Remove active from all tabs
            document.querySelectorAll('.showtimes-date-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            // Activate clicked tab
            clickedTab.classList.add('active');

            // Hide all time panels
            const selectedDate = clickedTab.getAttribute('data-date');
            document.querySelectorAll('.showtimes-times').forEach(panel => {
                panel.style.display = 'none';
            });
            // Show matching panel
            const target = document.querySelector('.showtimes-times[data-date="' + selectedDate + '"]');
            if (target) target.style.display = 'flex';
        }

        (() => {
            const form = document.querySelector('[data-review-form]');
            if (!form) {
                return;
            }

            const ratingInput = form.querySelector('[data-review-rating]');
            const range = form.querySelector('[data-review-rating-range]');
            const stars = Array.from(form.querySelectorAll('[data-review-star]'));
            const label = form.querySelector('[data-review-rating-label]');
            const comment = form.querySelector('[data-review-comment]');
            const error = form.querySelector('[data-review-error]');
            const submit = form.querySelector('[data-review-submit]');
            const submitText = form.querySelector('[data-review-submit-text]');

            const setError = (message) => {
                if (error) {
                    error.textContent = message || '';
                }
            };

            const formatRating = (value) => value.toFixed(2).replace(/\.00$/, '');

            const setRating = (value) => {
                const rating = Math.max(0, Math.min(5, Number(value) || 0));
                ratingInput.value = rating > 0 ? rating.toFixed(2) : '';
                range.value = rating.toFixed(2);
                if (label) {
                    label.textContent = `${rating.toFixed(2)} / 5`;
                }

                stars.forEach((star) => {
                    const starValue = Number(star.dataset.ratingValue || 0);
                    star.classList.toggle('is-active', rating >= starValue);
                    star.classList.toggle('is-soft-active', rating > starValue - 1 && rating < starValue);
                });
            };

            stars.forEach((star) => {
                star.addEventListener('click', () => {
                    setRating(Number(star.dataset.ratingValue || 0));
                    setError('');
                });
            });

            range?.addEventListener('input', () => {
                setRating(range.value);
                setError('');
            });

            comment?.addEventListener('input', () => setError(''));

            form.addEventListener('submit', (event) => {
                if (!ratingInput.value) {
                    event.preventDefault();
                    setError('Vui lòng chọn điểm đánh giá.');
                    return;
                }

                if (!comment?.value.trim()) {
                    event.preventDefault();
                    setError('Vui lòng nhập nội dung đánh giá.');
                    comment?.focus();
                    return;
                }

                submit?.setAttribute('disabled', 'disabled');
                submit?.classList.add('is-loading');
                if (submitText) {
                    submitText.textContent = 'Đang gửi...';
                }
            });

            setRating(0);
        })();
    </script>
}
