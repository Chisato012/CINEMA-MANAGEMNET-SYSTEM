<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema_Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/movie.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ticketprice.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cinema_Management.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<style>

</style>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark custom-navbar">
            <div class="container-fluid px-4 py-2">

                <a class="navbar-brand fw-bold m-0 cosmos-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/img/poster/logo.png" alt="">
                </a>

                <div class="d-none d-lg-flex gap-4 ms-5 me-auto ">
                    <a class="cosmos-nav-link" asp-area="" asp-controller="Home" asp-action="Movie">Phim</a>
                    <a class="cosmos-nav-link" asp-area="" asp-controller="Home" asp-action="TicketPricing">Giá vé</a>
                    <a href="#" class="cosmos-nav-link">Ưu đãi</a>
                    <a class="cosmos-nav-link" data-booking-nav-warning="true" >Đặt vé</a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        var displayName = Context.Session.GetString("UserFullName")
                            ?? Context.Session.GetString("UserEmail");
                        var avatarInitial = !string.IsNullOrWhiteSpace(displayName)
                            ? displayName.Trim()[0].ToString().ToUpperInvariant()
                            : "C";

                        <div class="navbar-account d-flex align-items-center gap-2">
                            <span class="cosmos-welcome">
                                <span class="cosmos-welcome-label">Chào mừng</span>
                                <span class="cosmos-welcome-name">@displayName</span>
                            </span>

                            <a asp-controller="Account" asp-action="Profile" class="cosmos-profile-button"
                               aria-label="Trang cá nhân" title="Trang cá nhân">
                                <span class="cosmos-profile-avatar" aria-hidden="true">@avatarInitial</span>
                            </a>

                            <a asp-controller="Account" asp-action="Logout" class="cosmos-icon-button cosmos-logout-button"
                               aria-label="Đăng xuất" title="Đăng xuất">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                                    <path
                                    d="M10 4.75A2.75 2.75 0 0 0 7.25 7.5v9A2.75 2.75 0 0 0 10 19.25h2a.75.75 0 0 1 0 1.5h-2a4.25 4.25 0 0 1-4.25-4.25v-9A4.25 4.25 0 0 1 10 3.25h2a.75.75 0 0 1 0 1.5h-2Z" />
                                    <path
                                    d="M15.47 7.47a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 1 1-1.06-1.06l2.72-2.72H10.5a.75.75 0 0 1 0-1.5h7.69l-2.72-2.72a.75.75 0 0 1 0-1.06Z" />
                                </svg>
                            </a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="cosmos-icon-button cosmos-login-button"
                           aria-label="Đăng nhập" title="Đăng nhập">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true">
                                <path
                                d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" />
                            </svg>
                        </a>
                    }
                </div>

            </div>
        </nav>
    </header>
    <div class="container-fluid px-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    
        <footer class="cosmos-movie-footer">
        <div class="cosmos-movie-footer__brand">
            <a class="cosmos-movie-footer__logo" asp-controller="Home" asp-action="Index">COSMOS<span>CINEMA</span></a>
            <p>Cinema nights, curated beautifully.</p>
        </div>

        <nav class="cosmos-movie-footer__links" aria-label="Footer navigation">
            <div>
                <h3>About COSMOS</h3>
                <a href="#">About Us</a>
                <a href="#">Our Cinemas</a>
                <a href="#">Careers</a>
                <a href="#">News & Events</a>
            </div>
            <div>
                <h3>Support</h3>
                <a href="#">FAQs</a>
                <a href="#">Help Center</a>
                <a href="#">Booking Guide</a>
                <a href="#">Contact Us</a>
            </div>
        </nav>

        <div class="cosmos-movie-footer__signup">
            <h3>Luôn cập nhật thông tin</h3>
            <p>Nhận thông tin về các bộ phim và ưu đãi mới nhất ngay trong hộp thư đến của bạn.</p>
            <form>
                <label for="footerEmail" class="visually-hidden">Email address</label>
                <input id="footerEmail" type="email" placeholder="Enter your email" />
                <button type="submit">Subscribe</button>
            </form>
        </div>

        <div class="cosmos-movie-footer__bottom">
            <span>&copy; @DateTime.Now.Year COSMOS CINEMA. All rights reserved.</span>
            <span>Terms of Use</span>
            <span>Privacy Policy</span>
            <span>Cookie Policy</span>
        </div>
    </footer>
    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @* ====== TOAST NOTIFICATION SYSTEM ====== *@
    <div aria-live="polite" aria-atomic="true" style="position: fixed; top: 20px; right: 20px; z-index: 99999;">
        @if (TempData["AlertSuccess"] != null)
        {
            <div class="toast align-items-center text-white border-0 show" role="alert"
                 style="background: linear-gradient(135deg, #28a745, #218838); min-width: 350px; border-radius: 12px; box-shadow: 0 8px 32px rgba(40,167,69,0.3);">
                <div class="d-flex">
                    <div class="toast-body" style="font-size: 0.95rem; padding: 16px 20px;">
                        @TempData["AlertSuccess"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["AlertError"] != null)
        {
            <div class="toast align-items-center text-white border-0 show" role="alert"
                 style="background: linear-gradient(135deg, #dc3545, #c82333); min-width: 350px; border-radius: 12px; box-shadow: 0 8px 32px rgba(220,53,69,0.3);">
                <div class="d-flex">
                    <div class="toast-body" style="font-size: 0.95rem; padding: 16px 20px;">
                        @TempData["AlertError"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <script>
            // Auto-hide toasts after 5 seconds
            document.addEventListener('DOMContentLoaded', function () {
                var toasts = document.querySelectorAll('.toast.show');
                toasts.forEach(function (toast) {
                    setTimeout(function () {
                        toast.classList.remove('show');
                        toast.style.transition = 'opacity 0.5s ease';
                        toast.style.opacity = '0';
                        setTimeout(function () { toast.remove(); }, 500);
                    }, 5000);
                });
            });
    </script>
</body>

</html>
