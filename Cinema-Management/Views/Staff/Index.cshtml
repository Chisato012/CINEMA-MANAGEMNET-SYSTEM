<div id="movieScheduleModal" class="modal-backdrop">
    <form class="modal-dialog schedule-modal" id="movieScheduleForm">
        <div class="modal-header">
            <div>
                <p class="modal-pretitle">QUẢN LÝ LỊCH CHIẾU</p>
                <h3>Thêm phim vào phòng chiếu</h3>
            </div>
            <button type="button" class="btn-close-modal" aria-label="Close schedule dialog">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <div class="modal-body schedule-modal-body">
            <div class="schedule-modal-summary">
                <span>PHIM ĐÃ CHỌN</span>
                <strong id="scheduleMovieTitle">No movie selected</strong>
                <small id="scheduleMovieDuration">0 min</small>
            </div>

            <div class="form-group">
                <label for="scheduleStartTime">Thời gian bắt đầu</label>
                <input type="time" id="scheduleStartTime" min="08:00" max="23:45" step="900" required />
            </div>
            
            <div class="form-group">
                <label>TẤT CẢ PHÒNG CHIẾU</label>
                <div class="schedule-room-tools">
                    <button type="button" class="schedule-room-tool" id="selectAllRooms">CHỌN TẤT CẢ</button>
                    <button type="button" class="schedule-room-tool" id="clearAllRooms">XOÁ</button>
                </div>
                <div class="schedule-room-grid">
                    @foreach (var room in Model.Rooms)
                    {
                        <label class="schedule-room-option">
                            <input type="checkbox" name="scheduleRoom" value="@room.RoomID" data-room-name="@room.RoomName" />
                            <span>
                                <strong>@room.RoomName</strong>
                                <small>@room.DisplayType - @room.SeatCount seats</small>
                            </span>
                        </label>
                    }
                </div>
            </div>

            <p class="schedule-form-error" id="scheduleFormError" role="alert" hidden></p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary btn-close-modal" style="border:none">HUỶ</button>
            <button type="submit" class="btn-primary" style="background:var(--color-primary-300);color:var(--color-neutral-950);font-weight:800;">THÊM VÀO LỊCH CHIẾU</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const editorModal = document.getElementById('movieEditorModal');
        const createModal = document.getElementById('movieCreateModal');
        const scheduleModal = document.getElementById('movieScheduleModal');
        const scheduleMovieForm = document.getElementById('movieScheduleForm');
        const scheduleMovieTitle = document.getElementById('scheduleMovieTitle');
        const scheduleMovieDuration = document.getElementById('scheduleMovieDuration');
        const scheduleStartTimeInput = document.getElementById('scheduleStartTime');
        let scheduleEndTimeInput = document.getElementById('scheduleEndTime');
        const scheduleFormError = document.getElementById('scheduleFormError');
        const selectAllRoomsButton = document.getElementById('selectAllRooms');
        const clearAllRoomsButton = document.getElementById('clearAllRooms');
        const btnAddMovie = document.getElementById('btnAddMovie');
        const scheduleDateInput = document.getElementById('scheduleDate');
        const btnSaveSchedule = document.getElementById('btnSaveSchedule');
        const movieSearchInput = document.getElementById('movieSearchInput');
        const movieSearchEmpty = document.getElementById('movieSearchEmpty');
        const scheduleStartHour = 8;
        const scheduleEndHour = 24;
        const scheduleTotalMinutes = (scheduleEndHour - scheduleStartHour) * 60;
        const scheduleSnapMinutes = 15;
        const scheduleDefaultBasePrice = 90000;
        
        const closeBtns = document.querySelectorAll('.btn-close-modal');
        const editBtns = document.querySelectorAll('.edit-movie-btn');
        const scheduleMovieBtns = document.querySelectorAll('.schedule-movie-btn');
        const scheduleRoomInputs = Array.from(document.querySelectorAll('input[name="scheduleRoom"]'));
        const telemetryText = document.querySelector('.telemetry p');
        let selectedScheduleMovie = null;

        function setTelemetry(message) {
            if (telemetryText) {
                telemetryText.textContent = `TELEMETRY LOGS: ${message}`;
            }
        }

        function getMoviePayload(item) {
            return {
                movieId: Number(item.dataset.movieId),
                title: item.dataset.title || '',
                duration: Number(item.dataset.duration || 0)
            };
        }

        function getMoviePayloadById(movieId, fallbackBlock = null) {
            const item = document.querySelector(`.movie-list-item[data-movie-id="${movieId}"]`);
            if (item) {
                return getMoviePayload(item);
            }

            return {
                movieId: Number(movieId),
                title: fallbackBlock?.querySelector('.schedule-block-title')?.textContent || 'Selected movie',
                duration: Number(fallbackBlock?.dataset.duration || scheduleSnapMinutes)
            };
        }

        function normalizeText(value) {
            return (value || '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/\s+/g, ' ')
                .trim();
        }

        function filterMoviesByName() {
            const keyword = normalizeText(movieSearchInput?.value);
            let visibleCount = 0;

            document.querySelectorAll('.movie-list-item').forEach(item => {
                const title = normalizeText(item.dataset.title);
                const genre = normalizeText(item.dataset.genre);
                const titleMatches = title.includes(keyword);
                const genreMatches = !titleMatches && genre.includes(keyword);
                const isVisible = !keyword || titleMatches || genreMatches;
                item.classList.toggle('is-search-hidden', !isVisible);

                if (isVisible) {
                    visibleCount++;
                }
            });

            if (movieSearchEmpty) {
                movieSearchEmpty.hidden = visibleCount > 0;
            }

            if (keyword) {
                setTelemetry(`Tim thay ${visibleCount} phim phu hop.`);
            }
        }

        function minutesToTime(minutesFromStart) {
            const totalMinutes = scheduleStartHour * 60 + minutesFromStart;
            const hours = Math.floor(totalMinutes / 60);
            const minutes = totalMinutes % 60;
            return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
        }

        function timeToMinutes(time) {
            const parts = time.split(':').map(Number);
            return ((parts[0] * 60) + parts[1]) - (scheduleStartHour * 60);
        }

        function clockTimeToMinutes(time) {
            const parts = time.split(':').map(Number);
            return (parts[0] * 60) + parts[1];
        }

        function clampStart(startMinutes, duration) {
            return Math.max(0, Math.min(startMinutes, scheduleTotalMinutes - duration));
        }

        function createScheduleBlock({ showtimeId, movieId, title, duration, startMinutes, basePrice }) {
            const block = document.createElement('div');
            const safeDuration = Math.max(duration || scheduleSnapMinutes, scheduleSnapMinutes);
            const safeStart = clampStart(startMinutes, safeDuration);

            block.className = 'schedule-block';
            block.dataset.showtimeId = showtimeId || '';
            block.dataset.movieId = movieId;
            block.dataset.title = title;
            block.dataset.duration = safeDuration;
            block.dataset.startTime = minutesToTime(safeStart);
            block.dataset.endTime = minutesToTime(safeStart + safeDuration);
            block.dataset.basePrice = basePrice || scheduleDefaultBasePrice;
            block.style.left = `${(safeStart / scheduleTotalMinutes) * 100}%`;
            block.style.width = `${(safeDuration / scheduleTotalMinutes) * 100}%`;
            block.innerHTML = `
                <button type="button" class="schedule-block-remove" title="Xoa lich">&times;</button>
                <span class="schedule-block-title"></span>
                <span class="schedule-block-time"></span>
            `;
            block.querySelector('.schedule-block-title').textContent = title;
            block.querySelector('.schedule-block-time').textContent = `${block.dataset.startTime} - ${block.dataset.endTime}`;
            block.querySelector('.schedule-block-remove').addEventListener('click', event => {
                event.stopPropagation();
                block.remove();
                syncScheduleRoomStateForSelectedTime();
            });
            block.addEventListener('click', () => {
                openScheduleModal(getMoviePayloadById(movieId, block), block.dataset.startTime);
            });
            return block;
        }

        function addScheduleBlock(timeline, movie, startMinutes) {
            const resolvedMovieId = movie.movieId ?? movie.movieID ?? movie.MovieID;
            const block = createScheduleBlock({
                showtimeId: movie.showtimeId ?? movie.showtimeID ?? movie.ShowtimeID,
                movieId: resolvedMovieId,
                title: movie.title,
                duration: movie.duration,
                basePrice: movie.basePrice,
                startMinutes
            });
            timeline.appendChild(block);
        }

        function timelineHasOverlap(timeline, startMinutes, endMinutes, ignoredBlock = null) {
            return Array.from(timeline.querySelectorAll('.schedule-block')).some(block => {
                if (block === ignoredBlock) {
                    return false;
                }

                const blockStart = timeToMinutes(block.dataset.startTime);
                const blockEnd = timeToMinutes(block.dataset.endTime);
                return startMinutes < blockEnd && endMinutes > blockStart;
            });
        }

        function getSchedulePayloadItems() {
            return Array.from(document.querySelectorAll('.mr-timeline')).flatMap(timeline =>
                Array.from(timeline.querySelectorAll('.schedule-block')).map(block => ({
                    ShowtimeID: Number(block.dataset.showtimeId || 0),
                    MovieID: Number(block.dataset.movieId),
                    RoomID: Number(timeline.dataset.roomId || timeline.dataset.hallNumber),
                    Date: scheduleDateInput.value,
                    StartTime: buildScheduleDateTime(block.dataset.startTime),
                    EndTime: buildScheduleDateTime(block.dataset.endTime),
                    BasePrice: Number(block.dataset.basePrice || scheduleDefaultBasePrice),
                    _startMinutes: timeToMinutes(block.dataset.startTime),
                    _endMinutes: timeToMinutes(block.dataset.endTime)
                }))
            );
        }

        function findInvalidScheduleItem(items) {
            return items.find(item =>
                !Number.isInteger(item.MovieID) || item.MovieID <= 0 ||
                !Number.isInteger(item.RoomID) || item.RoomID <= 0 ||
                !Number.isFinite(item.BasePrice) || item.BasePrice <= 0 ||
                item._endMinutes <= item._startMinutes
            );
        }

        function findOverlappingScheduleItem(items) {
            const grouped = items.reduce((map, item) => {
                if (!map.has(item.RoomID)) {
                    map.set(item.RoomID, []);
                }
                map.get(item.RoomID).push(item);
                return map;
            }, new Map());

            for (const roomItems of grouped.values()) {
                const ordered = roomItems.slice().sort((a, b) => a._startMinutes - b._startMinutes);
                for (let i = 1; i < ordered.length; i++) {
                    if (ordered[i - 1]._endMinutes > ordered[i]._startMinutes) {
                        return ordered[i];
                    }
                }
            }

            return null;
        }

        function getRoomLabel(timeline, fallbackId) {
            return timeline?.dataset.roomName || `Room ${fallbackId}`;
        }

        function getTimelineForRoomId(roomId) {
            return document.querySelector(`.mr-timeline[data-room-id="${roomId}"], .mr-timeline[data-hall-number="${roomId}"]`);
        }

        function findMovieBlockAtStart(timeline, movieId, startMinutes) {
            if (!timeline || !Number.isInteger(startMinutes)) {
                return null;
            }

            return Array.from(timeline.querySelectorAll('.schedule-block')).find(block =>
                Number(block.dataset.movieId) === Number(movieId) &&
                timeToMinutes(block.dataset.startTime) === startMinutes
            ) || null;
        }

        function getScheduleRooms() {
            return scheduleRoomInputs
                .map(input => ({
                    input,
                    option: input.closest('.schedule-room-option'),
                    roomId: Number(input.value),
                    roomName: input.dataset.roomName || `Room ${input.value}`,
                    timeline: getTimelineForRoomId(input.value)
                }))
                .filter(room => Number.isInteger(room.roomId) && room.roomId > 0 && room.timeline);
        }

        function syncScheduleRoomStateForSelectedTime() {
            if (!selectedScheduleMovie || !scheduleStartTimeInput) {
                return;
            }

            const duration = getSelectedScheduleDuration();
            const startMinutes = normalizeScheduleStartMinutes(scheduleStartTimeInput.value, duration);
            if (startMinutes === null) {
                scheduleRoomInputs.forEach(input => {
                    input.checked = false;
                    input.disabled = false;
                    input.closest('.schedule-room-option')?.classList.remove('is-pending', 'is-scheduled', 'is-conflict');
                });
                return;
            }

            const endMinutes = startMinutes + duration;
            getScheduleRooms().forEach(room => {
                const existingBlock = findMovieBlockAtStart(room.timeline, selectedScheduleMovie.movieId, startMinutes);
                const conflictingBlock = Array.from(room.timeline.querySelectorAll('.schedule-block')).find(block => {
                    if (block === existingBlock) {
                        return false;
                    }

                    const blockStart = timeToMinutes(block.dataset.startTime);
                    const blockEnd = timeToMinutes(block.dataset.endTime);
                    return startMinutes < blockEnd && endMinutes > blockStart;
                });

                room.input.checked = Boolean(existingBlock);
                room.input.disabled = Boolean(conflictingBlock && !existingBlock);
                room.option?.classList.toggle('is-pending', Boolean(existingBlock));
                room.option?.classList.toggle('is-scheduled', Boolean(existingBlock));
                room.option?.classList.toggle('is-conflict', Boolean(conflictingBlock && !existingBlock));
            });
        }

        function setScheduleFormError(message) {
            if (!scheduleFormError) {
                return;
            }

            scheduleFormError.textContent = message || '';
            scheduleFormError.hidden = !message;
        }

        function ensureScheduleEndTimeField() {
            if (!scheduleStartTimeInput || scheduleEndTimeInput) {
                return;
            }

            const timeGroup = scheduleStartTimeInput.closest('.form-group');
            if (!timeGroup) {
                return;
            }

            const label = document.createElement('label');
            label.htmlFor = 'scheduleEndTime';
            label.className = 'schedule-end-label';
            label.textContent = 'THỜI GIAN KẾT THÚC';

            const input = document.createElement('input');
            input.type = 'text';
            input.id = 'scheduleEndTime';
            input.readOnly = true;
            input.value = '--:--';

            const helper = document.createElement('small');
            helper.className = 'schedule-helper schedule-end-helper';

            timeGroup.appendChild(label);
            timeGroup.appendChild(input);
            timeGroup.appendChild(helper);
            scheduleEndTimeInput = input;
        }

        function getSelectedScheduleDuration() {
            return Math.max(selectedScheduleMovie?.duration || scheduleSnapMinutes, scheduleSnapMinutes);
        }

        function updateScheduleEndTime() {
            if (!scheduleEndTimeInput || !scheduleStartTimeInput) {
                return;
            }

            const duration = getSelectedScheduleDuration();
            const startMinutes = normalizeScheduleStartMinutes(scheduleStartTimeInput.value, duration);
            scheduleEndTimeInput.value = startMinutes === null
                ? '--:--'
                : minutesToTime(startMinutes + duration);
        }

        function closeScheduleModal() {
            scheduleModal?.classList.remove('show');
            setScheduleFormError('');
        }

        function openScheduleModal(movie, startTime = '08:00') {
            selectedScheduleMovie = movie;
            if (scheduleMovieTitle) {
                scheduleMovieTitle.textContent = movie.title;
            }

            if (scheduleMovieDuration) {
                scheduleMovieDuration.textContent = `${movie.duration || scheduleSnapMinutes} min`;
            }

            if (scheduleStartTimeInput) {
                scheduleStartTimeInput.value = startTime;
            }

            updateScheduleEndTime();
            syncScheduleRoomStateForSelectedTime();

            setScheduleFormError('');
            scheduleModal?.classList.add('show');
            scheduleStartTimeInput?.focus();
        }

        function getSelectedScheduleRooms() {
            return getScheduleRooms().filter(room => room.input.checked && !room.input.disabled);
        }

        function normalizeScheduleStartMinutes(timeValue, duration) {
            if (!timeValue || !timeValue.includes(':')) {
                return null;
            }

            const rawMinutes = timeToMinutes(timeValue);
            if (!Number.isFinite(rawMinutes)) {
                return null;
            }

            const snapped = Math.round(rawMinutes / scheduleSnapMinutes) * scheduleSnapMinutes;
            if (snapped < 0 || snapped + duration > scheduleTotalMinutes) {
                return null;
            }

            return snapped;
        }

        function addMovieToSelectedRooms(event) {
            event.preventDefault();

            if (!selectedScheduleMovie) {
                setScheduleFormError('Choose a movie before adding a schedule.');
                return;
            }

            const duration = Math.max(selectedScheduleMovie.duration || scheduleSnapMinutes, scheduleSnapMinutes);
            const startMinutes = normalizeScheduleStartMinutes(scheduleStartTimeInput?.value, duration);
            if (startMinutes === null) {
                setScheduleFormError('Start time must keep the full movie between 08:00 and 24:00.');
                return;
            }

            const endMinutes = startMinutes + duration;
            const selectedRoomIds = new Set(getSelectedScheduleRooms().map(room => room.roomId));
            const rooms = getScheduleRooms();
            const additions = [];
            const removals = [];
            const conflicts = [];

            rooms.forEach(room => {
                const existingBlock = findMovieBlockAtStart(room.timeline, selectedScheduleMovie.movieId, startMinutes);
                const shouldSchedule = selectedRoomIds.has(room.roomId);

                if (shouldSchedule && !existingBlock) {
                    if (timelineHasOverlap(room.timeline, startMinutes, endMinutes)) {
                        conflicts.push(room);
                    } else {
                        additions.push(room);
                    }
                }

                if (!shouldSchedule && existingBlock) {
                    removals.push(existingBlock);
                }
            });

            if (selectedRoomIds.size === 0 && removals.length === 0) {
                setScheduleFormError('Select at least one screening room, or uncheck an existing room to remove it.');
                return;
            }

            if (conflicts.length > 0) {
                setScheduleFormError(`Schedule overlaps in ${conflicts.map(room => getRoomLabel(room.timeline, room.roomId)).join(', ')}.`);
                return;
            }

            removals.forEach(block => block.remove());
            additions.forEach(room => {
                addScheduleBlock(room.timeline, selectedScheduleMovie, startMinutes);
            });

            setTelemetry(`Updated "${selectedScheduleMovie.title}" at ${minutesToTime(startMinutes)}: added ${additions.length}, removed ${removals.length}.`);
            closeScheduleModal();
        }

        movieSearchInput?.addEventListener('input', filterMoviesByName);
        filterMoviesByName();
        ensureScheduleEndTimeField();
        updateScheduleEndTime();

        async function loadSchedule() {
            document.querySelectorAll('.schedule-block').forEach(block => block.remove());

            const response = await fetch(`/Staff/GetSchedule?date=${encodeURIComponent(scheduleDateInput.value)}`);
            if (!response.ok) {
                setTelemetry('Khong tai duoc lich chieu.');
                return;
            }

            const showtimes = await response.json();
            showtimes.forEach(showtime => {
                const roomId = showtime.roomId || showtime.roomID || showtime.hallNumber;
                const timeline = document.querySelector(`.mr-timeline[data-room-id="${roomId}"], .mr-timeline[data-hall-number="${roomId}"]`);
                if (!timeline) {
                    return;
                }

                addScheduleBlock(timeline, {
                    showtimeId: showtime.showtimeId ?? showtime.showtimeID ?? showtime.ShowtimeID,
                    movieId: showtime.movieId ?? showtime.movieID ?? showtime.MovieID,
                    title: showtime.movieTitle,
                    duration: showtime.duration,
                    basePrice: showtime.basePrice
                }, timeToMinutes(showtime.startTime));
            });

            setTelemetry(`Da tai ${showtimes.length} suat chieu.`);
            syncScheduleRoomStateForSelectedTime();
        }

        function buildScheduleDateTime(time) {
            const [hours, minutes] = time.split(':').map(Number);
            const value = new Date(`${scheduleDateInput.value}T00:00:00`);
            value.setMinutes(value.getMinutes() + (hours * 60) + minutes);

            const year = value.getFullYear();
            const month = String(value.getMonth() + 1).padStart(2, '0');
            const day = String(value.getDate()).padStart(2, '0');
            const resolvedHours = String(value.getHours()).padStart(2, '0');
            const resolvedMinutes = String(value.getMinutes()).padStart(2, '0');

            return `${year}-${month}-${day}T${resolvedHours}:${resolvedMinutes}:00`;
        }

        async function readScheduleResponse(response) {
            const text = await response.text();
            if (!text) {
                return {};
            }

            try {
                return JSON.parse(text);
            } catch {
                return {
                    message: `Server tra ve phan hoi khong phai JSON (${response.status}).`,
                    detail: text.slice(0, 300)
                };
            }
        }

        async function saveSchedule() {
            const payloadItems = getSchedulePayloadItems();
            const invalidItem = findInvalidScheduleItem(payloadItems);
            if (invalidItem) {
                setTelemetry(`Du lieu lich chieu khong hop le: MovieID=${invalidItem.MovieID}, RoomID=${invalidItem.RoomID}, BasePrice=${invalidItem.BasePrice}.`);
                return;
            }

            const overlapItem = findOverlappingScheduleItem(payloadItems);
            if (overlapItem) {
                setTelemetry(`Lich chieu bi trung gio trong phong ${overlapItem.RoomID}.`);
                return;
            }

            const items = payloadItems.map(({ _startMinutes, _endMinutes, ...item }) => item);

            const response = await fetch('/Staff/SaveSchedule', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Date: scheduleDateInput.value,
                    Items: items
                })
            });

            const result = await readScheduleResponse(response);
            if (!response.ok) {
                const details = result.errors
                    ? Object.entries(result.errors)
                        .map(([field, messages]) => `${field}: ${messages.join(', ')}`)
                        .join(' | ')
                    : result.detail || '';
                setTelemetry(details ? `${result.message}: ${details}` : result.message || 'Luu lich that bai.');
                return;
            }

            setTelemetry(`${result.message} (${result.count} suat chieu, them ${result.created || 0}, cap nhat ${result.updated || 0}, xoa ${result.deleted || 0})`);
            await loadSchedule();
        }

        btnSaveSchedule.addEventListener('click', saveSchedule);
        scheduleDateInput.addEventListener('change', loadSchedule);
        loadSchedule();

        btnAddMovie.addEventListener('click', () => {
            createModal.classList.add('show');
        });

        scheduleMovieBtns.forEach(btn => {
            btn.addEventListener('click', event => {
                const item = event.currentTarget.closest('.movie-list-item');
                if (!item) {
                    return;
                }

                openScheduleModal(getMoviePayload(item));
            });
        });

        scheduleMovieForm?.addEventListener('submit', addMovieToSelectedRooms);
        scheduleStartTimeInput?.addEventListener('input', () => {
            updateScheduleEndTime();
            syncScheduleRoomStateForSelectedTime();
            setScheduleFormError('');
        });
        scheduleStartTimeInput?.addEventListener('change', () => {
            updateScheduleEndTime();
            syncScheduleRoomStateForSelectedTime();
            setScheduleFormError('');
        });

        scheduleRoomInputs.forEach(input => {
            input.addEventListener('change', () => {
                input.closest('.schedule-room-option')?.classList.toggle('is-pending', input.checked);
                setScheduleFormError('');
            });
        });

        selectAllRoomsButton?.addEventListener('click', () => {
            scheduleRoomInputs.forEach(input => {
                if (!input.disabled) {
                    input.checked = true;
                    input.closest('.schedule-room-option')?.classList.add('is-pending');
                }
            });
            setScheduleFormError('');
        });

        clearAllRoomsButton?.addEventListener('click', () => {
            scheduleRoomInputs.forEach(input => {
                input.checked = false;
                input.closest('.schedule-room-option')?.classList.remove('is-pending');
            });
        });

        // Live Poster Preview logic
        document.getElementById('createPosterInput').addEventListener('input', function() {
            const preview = document.getElementById('createPosterPreview');
            const placeholder = document.getElementById('createPosterPlaceholder');
            if (this.value) {
                preview.src = this.value;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
            } else {
                preview.src = '';
                preview.style.display = 'none';
                placeholder.style.display = 'block';
            }
        });

        document.getElementById('editPoster').addEventListener('input', function() {
            const preview = document.getElementById('editPosterPreview');
            const placeholder = document.getElementById('editPosterPlaceholder');
            if (this.value) {
                preview.src = this.value;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
            } else {
                preview.src = '';
                preview.style.display = 'none';
                placeholder.style.display = 'block';
            }
        });
        
        // Event delegation — bắt click trên toàn bộ movies-list
        const moviesList = document.querySelector('.movies-list');
        editBtns.forEach(btn =>{
            btn.addEventListener('click', (e) => {
                const editBtn = e.target.closest('.edit-movie-btn');
                
                const item = editBtn.closest('.movie-list-item');
                if (item) {
                    document.getElementById('editMovieID').value = item.dataset.movieId || '';
                    document.getElementById('editTitle').value = item.dataset.title || '';
                    document.getElementById('editDuration').value = item.dataset.duration || '';
                    document.getElementById('editSynopsis').value = item.dataset.synopsis || '';
                    document.getElementById('editTrailer').value = item.dataset.trailer || '';
                    document.getElementById('editPoster').value = item.dataset.poster || '';
                    document.getElementById('editGenre').value = item.dataset.genre || '';
                    document.getElementById('editReleaseDate').value = item.dataset.releaseDate || '';
                    // trigger input event to show image
                    document.getElementById('editPoster').dispatchEvent(new Event('input'));
                    
                    const rating = item.dataset.rating || '';
                    const select = document.getElementById('editRating');
                    for (let i = 0; i < select.options.length; i++) {
                        if (select.options[i].value === rating) {
                            select.selectedIndex = i;
                            break;
                        }
                    }
                }
                editorModal.classList.add('show');
            });
        });

        closeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                editorModal.classList.remove('show');
                createModal.classList.remove('show');
                closeScheduleModal();
            });
        });
        
        // Format tag toggle
        document.querySelectorAll('.format-tag').forEach(tag => {
            tag.addEventListener('click', function() {
                this.classList.toggle('active');
            });
        });
    </script>
}
